diff --git a/codex-rs/http-client/src/cc_lb.rs b/codex-rs/http-client/src/cc_lb.rs
new file mode 100644
index 0000000000..eb7a3cd4ca
--- /dev/null
+++ b/codex-rs/http-client/src/cc_lb.rs
@@ -0,0 +1,329 @@
+use http::header::{HeaderMap, HeaderName};
+use http::StatusCode;
+use url::Url;
+
+const ERROR_ORIGIN: HeaderName = HeaderName::from_static("cc-lb-error-origin");
+const AUTH_REASON: HeaderName = HeaderName::from_static("cc-lb-auth-reason");
+
+/// The response source is selected by the client adapter, never inferred from a URL.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum CcLbResponseSource {
+    HttpResponse,
+    WebSocketHandshake,
+    InBand,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum CcLbErrorOrigin {
+    Principal,
+    Renewal,
+    Relay,
+    Upstream,
+    Proxy,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum CcLbAuthReason {
+    Expired,
+}
+
+/// Auth provenance authenticated by the configured cc-lb TLS origin.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct CcLbAuthProvenance {
+    pub origin: CcLbErrorOrigin,
+    pub auth_reason: Option<CcLbAuthReason>,
+    status: StatusCode,
+}
+
+impl CcLbAuthProvenance {
+    pub fn allows_principal_refresh(self) -> bool {
+        self.is_expired_principal_unauthorized(self.status)
+    }
+
+    pub fn allows_relay_refresh(self) -> bool {
+        self.origin == CcLbErrorOrigin::Relay && self.status == StatusCode::UNAUTHORIZED
+    }
+
+    pub fn is_expired_principal_unauthorized(self, status: StatusCode) -> bool {
+        self.origin == CcLbErrorOrigin::Principal
+            && self.auth_reason == Some(CcLbAuthReason::Expired)
+            && self.status == StatusCode::UNAUTHORIZED
+            && status == self.status
+    }
+}
+
+/// Classifies a response from the configured cc-lb HTTP transport.
+///
+/// The response URL must be the effective URL returned by the HTTP implementation. A request URL
+/// supplied by a caller is not sufficient because redirects and route-aware clients can change it.
+pub fn cc_lb_auth_provenance(
+    expected_origin: &str,
+    response_url: Option<&str>,
+    status: StatusCode,
+    headers: &HeaderMap,
+) -> Option<CcLbAuthProvenance> {
+    cc_lb_auth_provenance_for(
+        CcLbResponseSource::HttpResponse,
+        expected_origin,
+        response_url,
+        status,
+        headers,
+    )
+}
+
+/// Classifies a response with an explicit client-owned source discriminator.
+///
+/// In-band WebSocket error frames are never trusted as transport provenance, even if a future
+/// adapter supplies a URL or forwards response-like headers.
+pub fn cc_lb_auth_provenance_for(
+    source: CcLbResponseSource,
+    expected_origin: &str,
+    response_url: Option<&str>,
+    status: StatusCode,
+    headers: &HeaderMap,
+) -> Option<CcLbAuthProvenance> {
+    if source == CcLbResponseSource::InBand {
+        return None;
+    }
+    let expected = normalized_expected_origin(expected_origin)?;
+    let response = normalized_response_origin(source, response_url?)?;
+    if expected.host() != response.host()
+        || expected.port_or_known_default() != response.port_or_known_default()
+    {
+        return None;
+    }
+
+    let origin = parse_error_origin(single_value(headers, &ERROR_ORIGIN)??)?;
+    let auth_reason = match single_value(headers, &AUTH_REASON)? {
+        None => None,
+        Some("expired")
+            if origin == CcLbErrorOrigin::Principal && status == StatusCode::UNAUTHORIZED =>
+        {
+            Some(CcLbAuthReason::Expired)
+        }
+        Some(_) => return None,
+    };
+    Some(CcLbAuthProvenance {
+        origin,
+        auth_reason,
+        status,
+    })
+}
+
+fn single_value<'a>(headers: &'a HeaderMap, name: &HeaderName) -> Option<Option<&'a str>> {
+    let mut values = headers.get_all(name).iter();
+    let first = values.next();
+    if values.next().is_some() {
+        return None;
+    }
+    match first {
+        Some(value) => Some(Some(value.to_str().ok()?)),
+        None => Some(None),
+    }
+}
+
+fn parse_error_origin(value: &str) -> Option<CcLbErrorOrigin> {
+    match value {
+        "principal" => Some(CcLbErrorOrigin::Principal),
+        "renewal" => Some(CcLbErrorOrigin::Renewal),
+        "relay" => Some(CcLbErrorOrigin::Relay),
+        "upstream" => Some(CcLbErrorOrigin::Upstream),
+        "proxy" => Some(CcLbErrorOrigin::Proxy),
+        _ => None,
+    }
+}
+
+fn normalized_expected_origin(value: &str) -> Option<Url> {
+    let url = Url::parse(value).ok()?;
+    if url.scheme() != "https"
+        || url.host_str().is_none()
+        || !url.username().is_empty()
+        || url.password().is_some()
+        || url.query().is_some()
+        || url.fragment().is_some()
+        || (url.path() != "" && url.path() != "/")
+    {
+        return None;
+    }
+    Some(url)
+}
+
+fn normalized_response_origin(source: CcLbResponseSource, value: &str) -> Option<Url> {
+    let mut url = Url::parse(value).ok()?;
+    if source == CcLbResponseSource::WebSocketHandshake && url.scheme() == "wss" {
+        url.set_scheme("https").ok()?;
+    }
+    if url.scheme() != "https"
+        || url.host_str().is_none()
+        || !url.username().is_empty()
+        || url.password().is_some()
+        || url.fragment().is_some()
+    {
+        return None;
+    }
+    Some(url)
+}
+
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use http::header::HeaderValue;
+
+    fn headers(origin: &'static str) -> HeaderMap {
+        let mut headers = HeaderMap::new();
+        headers.insert("cc-lb-error-origin", HeaderValue::from_static(origin));
+        headers
+    }
+
+    #[test]
+    fn accepts_exact_https_effective_origin_and_expiry() {
+        let mut headers = headers("principal");
+        headers.insert("cc-lb-auth-reason", HeaderValue::from_static("expired"));
+        let provenance = cc_lb_auth_provenance(
+            "https://Proxy.Example:443/",
+            Some("https://proxy.example/backend-api/codex"),
+            StatusCode::UNAUTHORIZED,
+            &headers,
+        );
+        assert_eq!(
+            provenance,
+            Some(CcLbAuthProvenance {
+                origin: CcLbErrorOrigin::Principal,
+                auth_reason: Some(CcLbAuthReason::Expired),
+                status: StatusCode::UNAUTHORIZED,
+            })
+        );
+    }
+
+    #[test]
+    fn rejects_in_band_even_with_matching_headers() {
+        let headers = headers("principal");
+        assert!(cc_lb_auth_provenance_for(
+            CcLbResponseSource::InBand,
+            "https://proxy.example",
+            Some("https://proxy.example/path"),
+            StatusCode::UNAUTHORIZED,
+            &headers,
+        )
+        .is_none());
+    }
+
+    #[test]
+    fn rejects_wrong_origin_and_duplicate_reserved_headers() {
+        let principal_headers = headers("principal");
+        assert!(cc_lb_auth_provenance(
+            "https://proxy.example",
+            Some("https://attacker.example/path"),
+            StatusCode::UNAUTHORIZED,
+            &principal_headers,
+        )
+        .is_none());
+
+        let mut duplicate = headers("principal");
+        duplicate.append(
+            "cc-lb-error-origin",
+            HeaderValue::from_static("proxy"),
+        );
+        assert!(cc_lb_auth_provenance(
+            "https://proxy.example",
+            Some("https://proxy.example/path"),
+            StatusCode::UNAUTHORIZED,
+            &duplicate,
+        )
+        .is_none());
+    }
+
+    #[test]
+    fn rejects_unknown_or_duplicate_reason() {
+        let mut unknown = headers("principal");
+        unknown.insert("cc-lb-auth-reason", HeaderValue::from_static("other"));
+        assert!(cc_lb_auth_provenance(
+            "https://proxy.example",
+            Some("https://proxy.example/path"),
+            StatusCode::UNAUTHORIZED,
+            &unknown,
+        )
+        .is_none());
+
+        let mut duplicate = headers("principal");
+        duplicate.append("cc-lb-auth-reason", HeaderValue::from_static("expired"));
+        duplicate.append("cc-lb-auth-reason", HeaderValue::from_static("expired"));
+        assert!(cc_lb_auth_provenance(
+            "https://proxy.example",
+            Some("https://proxy.example/path"),
+            StatusCode::UNAUTHORIZED,
+            &duplicate,
+        )
+        .is_none());
+    }
+
+    #[test]
+    fn only_principal_401_expired_can_refresh() {
+        for origin in ["principal", "renewal", "relay", "upstream", "proxy"] {
+            for status in [StatusCode::UNAUTHORIZED, StatusCode::FORBIDDEN, StatusCode::BAD_REQUEST,
+                StatusCode::TOO_MANY_REQUESTS, StatusCode::SERVICE_UNAVAILABLE] {
+                let response_headers = headers(origin);
+                let result = cc_lb_auth_provenance(
+                    "https://proxy.example",
+                    Some("https://proxy.example/backend-api/ps/mcp"),
+                    status,
+                    &response_headers,
+                ).expect("known origin without reason");
+                assert!(!result.allows_principal_refresh());
+                assert_eq!(result.allows_relay_refresh(),
+                    origin == "relay" && status == StatusCode::UNAUTHORIZED);
+
+                let mut expired_headers = response_headers;
+                expired_headers.insert("cc-lb-auth-reason", HeaderValue::from_static("expired"));
+                let expired = cc_lb_auth_provenance(
+                    "https://proxy.example",
+                    Some("https://proxy.example/backend-api/ps/mcp"),
+                    status,
+                    &expired_headers,
+                );
+                assert_eq!(expired.is_some_and(|value| value.allows_principal_refresh()),
+                    origin == "principal" && status == StatusCode::UNAUTHORIZED);
+            }
+        }
+    }
+
+    #[test]
+    fn rejects_missing_unknown_or_malformed_origin_and_non_tls_urls() {
+        for value in ["", "Principal", "unknown", "principal, principal"] {
+            assert!(cc_lb_auth_provenance(
+                "https://proxy.example", Some("https://proxy.example/path"),
+                StatusCode::UNAUTHORIZED, &headers(value),
+            ).is_none());
+        }
+        for url in [None, Some("http://proxy.example/path"),
+            Some("https://proxy.example:444/path"),
+            Some("https://proxy.example.attacker/path"),
+            Some("https://user@proxy.example/path")] {
+            assert!(cc_lb_auth_provenance(
+                "https://proxy.example", url,
+                StatusCode::UNAUTHORIZED, &headers("principal"),
+            ).is_none());
+        }
+        assert!(cc_lb_auth_provenance(
+            "https://proxy.example", Some("https://proxy.example/path"),
+            StatusCode::UNAUTHORIZED, &HeaderMap::new(),
+        ).is_none());
+    }
+
+    #[test]
+    fn only_explicit_tls_handshake_source_accepts_wss() {
+        let mut response_headers = headers("principal");
+        response_headers.insert("cc-lb-auth-reason", HeaderValue::from_static("expired"));
+        for source in [CcLbResponseSource::HttpResponse, CcLbResponseSource::WebSocketHandshake,
+            CcLbResponseSource::InBand] {
+            let result = cc_lb_auth_provenance_for(
+                source, "https://proxy.example",
+                Some("wss://proxy.example/backend-api/codex/responses"),
+                StatusCode::UNAUTHORIZED, &response_headers,
+            );
+            assert_eq!(result.is_some_and(|value| value.allows_principal_refresh()),
+                source == CcLbResponseSource::WebSocketHandshake);
+        }
+    }
+}
