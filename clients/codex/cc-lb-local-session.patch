+#[test]
+fn private_profile_normalizes_origin_and_isolates_profiles_and_ports() {
+    let home = tempfile::tempdir().unwrap();
+    let canonical = LocalSessionStore::new(home.path(), &profile("https://proxy.example", "default")).unwrap();
+    let explicit = LocalSessionStore::new(home.path(), &profile("https://PROXY.example:443/", "default")).unwrap();
+    assert_eq!(canonical.path(), explicit.path());
+    for other in [profile("https://proxy.example:8443", "default"), profile("https://other.example", "default"), profile("https://proxy.example", "other")] {
+        assert_ne!(canonical.path(), LocalSessionStore::new(home.path(), &other).unwrap().path());
+    }
+    assert!(!home.path().join("cc-lb").exists(), "validation does not create or read credential files");
