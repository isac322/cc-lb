+/// Attaches the exact provider handshake bytes carried as standard base64.
+///
+/// A missing, repeated, non-string or undecodable carrier leaves the ordinary in-band error.
+fn attach_cc_lb_provider_body(error: &mut ApiError, payload: &str) {
+    use base64::Engine as _;
+
+    #[derive(Deserialize)]
+    struct Carrier {
+        cc_lb_provider_body_base64: Option<String>,
+    }
+
+    let ApiError::Transport(TransportError::InBandHttp { raw_body, .. }) = error else {
+        return;
+    };
+    *raw_body = serde_json::from_str::<Carrier>(payload)
