+#[derive(Debug)]
+struct RenewalFailure {
+    status: http::StatusCode,
+    terminal_auth_failure: bool,
+}
+
+impl std::fmt::Display for RenewalFailure {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "cc-lb-local renewal rejected (HTTP {})", self.status)
+    }
+}
+
+impl std::error::Error for RenewalFailure {}
+
+pub(super) fn classify_refresh_error(error: io::Error) -> crate::RefreshTokenError {
+    if error.get_ref().and_then(|cause| cause.downcast_ref::<RenewalFailure>())
+        .is_some_and(|failure| failure.terminal_auth_failure)
+    {
+        crate::RefreshTokenError::Permanent(codex_protocol::auth::RefreshTokenFailedError::new(
+            codex_protocol::auth::RefreshTokenFailedReason::Other,
+            error.to_string(),
+        ))
+    } else {
+        crate::RefreshTokenError::Transient(error)
+    }
+}
+
+#[derive(Serialize)]
+struct RenewalRequest {
+    grant_type: &'static str,
+    expected_workspace_generation: u64,
+}
+
+#[derive(Serialize)]
+struct RevokeRequest {}
+
+#[derive(Deserialize)]
+struct RenewalResponse {
+    access_token: String,
+    expires_at: i64,
+    account_id: String,
+    user_id: String,
+    workspace_generation: u64,
+}
+
+/// Lifecycle requests carry only the local credential: no vendor cookies and no redirects.
+fn client(factory: codex_http_client::HttpClientFactory) -> RouteAwareClientPool {
+    RouteAwareClientPool::new_without_redirects_or_request_logging(factory, ClientRouteClass::Auth)
+}
+
+pub(super) async fn renew(home: &Path, profile: &CcLbConfig, route: &AuthRouteConfig, expected_access: &str) -> io::Result<()> {
+    let store = LocalSessionStore::new(home, profile)?;
+    let _operation = store.operation_guard().await?;
+    let previous = store.read()?.ok_or_else(invalid_session)?;
+    if previous.access_token != expected_access {
+        return Ok(()); // Another cooperating process completed rotation first.
+    }
+    let endpoint = format!("{}/oauth/token", store.profile.origin);
+    let response = client(route.authentication_factory(&endpoint)).post(endpoint)
+        .header(http::header::AUTHORIZATION, format!("Bearer {}", previous.renewal_token))
+        .json(&RenewalRequest { grant_type: "refresh_token", expected_workspace_generation: previous.workspace_generation })
+        .timeout(Duration::from_secs(30)).send().await.map_err(|_| io::Error::other("cc-lb-local renewal transport failed"))?;
+    if response.status() != http::StatusCode::OK {
+        let terminal_auth_failure = codex_http_client::cc_lb_auth_provenance(
+            &store.profile.origin, Some(response.url().as_str()), response.status(), response.headers(),
+        ).is_some_and(|provenance| provenance.origin == codex_http_client::CcLbErrorOrigin::Renewal
+            && response.status() == http::StatusCode::UNAUTHORIZED);
+        return Err(io::Error::other(RenewalFailure { status: response.status(), terminal_auth_failure }));
+    }
+    let updated: RenewalResponse = read_response(response).await?;
+    if updated.workspace_generation != previous.workspace_generation || updated.account_id != previous.account_id || updated.user_id != previous.user_id {
+        return Err(invalid_session());
+    }
+    let updated = LocalSession { access_token: updated.access_token, expires_at: updated.expires_at, ..previous.clone() };
+    store.compare_and_write(&previous, &updated)
+}
+
+#[derive(Debug)]
+pub struct LogoutOutcome {
+    pub local_erased: bool,
+    pub server_revoked: bool,
+}
+
+/// A failed/offline revoke never becomes a server-confirmed logout.
+pub async fn logout(home: &Path, profile: &CcLbConfig, route: &AuthRouteConfig) -> io::Result<LogoutOutcome> {
+    let store = LocalSessionStore::new(home, profile)?;
+    let _operation = store.operation_guard().await?;
+    let Some(previous) = store.read()? else { return Ok(LogoutOutcome { local_erased: false, server_revoked: false }); };
+    let endpoint = format!("{}/oauth/revoke", store.profile.origin);
+    let server_revoked = match client(route.authentication_factory(&endpoint)).post(endpoint)
+        .header(http::header::AUTHORIZATION, format!("Bearer {}", previous.renewal_token))
+        .json(&RevokeRequest {}).timeout(Duration::from_secs(10)).send().await {
+        Ok(response) => response.status() == http::StatusCode::NO_CONTENT,
+        Err(_) => false,
+    };
+    let _guard = store.lock()?;
+    if store.read()?.as_ref() != Some(&previous) {
+        return Err(io::Error::new(io::ErrorKind::Interrupted, "cc-lb-local session changed during logout; newer credentials retained"));
+    }
+    std::fs::remove_file(store.path())?;
+    Ok(LogoutOutcome { local_erased: true, server_revoked })
+}
+
+#[derive(Deserialize)]
+struct WorkspaceResponse {
+    access_token: String,
+    workspace_generation: u64,
+}
+#[derive(Debug, Clone, Deserialize, PartialEq, Eq)]
+pub struct LocalWorkspaceAlias {
+    pub workspace_id: String,
+}
+
+#[derive(Debug, Clone, Deserialize, PartialEq, Eq)]
+pub struct LocalWorkspaceDiscovery {
+    pub session_id: String,
+    pub workspace_generation: u64,
+    pub selected_workspace_id: String,
+    pub workspaces: Vec<LocalWorkspaceAlias>,
+}
+
+fn response_is_no_store(headers: &http::HeaderMap) -> bool {
+    headers
+        .get_all(http::header::CACHE_CONTROL)
+        .iter()
+        .filter_map(|value| value.to_str().ok())
+        .any(has_no_store_directive)
+}
+
+fn has_no_store_directive(value: &str) -> bool {
+    let mut start = 0;
+    let mut quoted = false;
+    let mut escaped = false;
+    for (offset, character) in value.char_indices() {
+        if escaped {
+            escaped = false;
+        } else if quoted && character == '\\' {
+            escaped = true;
+        } else if character == '"' {
+            quoted = !quoted;
+        } else if character == ',' && !quoted {
+            if value[start..offset].trim().eq_ignore_ascii_case("no-store") {
+                return true;
+            }
+            start = offset + 1;
+        }
+    }
+    !quoted && value[start..].trim().eq_ignore_ascii_case("no-store")
+}
+
+fn validate_workspace_discovery(
+    discovery: &LocalWorkspaceDiscovery,
+    session: &LocalSession,
+) -> io::Result<()> {
+    if discovery.session_id != session.session_id
+        || discovery.workspace_generation != session.workspace_generation
+        || discovery.selected_workspace_id != session.account_id
+    {
+        return Err(invalid_session());
+    }
+    let mut selected_count = 0;
+    let mut seen = std::collections::HashSet::new();
+    for workspace in &discovery.workspaces {
+        if workspace.workspace_id.is_empty()
+            || !seen.insert(&workspace.workspace_id)
+        {
+            return Err(invalid_session());
+        }
+        if workspace.workspace_id == session.account_id {
+            selected_count += 1;
+        }
+    }
+    if selected_count != 1 {
+        return Err(invalid_session());
+    }
+    Ok(())
+}
+
+async fn discover_workspaces(
+    store: &LocalSessionStore,
+    route: &AuthRouteConfig,
+    session: &LocalSession,
+) -> io::Result<LocalWorkspaceDiscovery> {
+    let endpoint = format!("{}/backend-api/cc-lb/workspaces", store.profile.origin);
+    let response = client(route.authentication_factory(&endpoint))
+        .get(&endpoint)
+        .header(
+            http::header::AUTHORIZATION,
+            format!("Bearer {}", session.access_token),
+        )
+        .timeout(Duration::from_secs(30))
+        .send()
+        .await
+        .map_err(|_| io::Error::other("cc-lb-local workspace discovery transport failed"))?;
+    if response.status() != http::StatusCode::OK
+        || response.url().as_str() != endpoint
+        || !response_is_no_store(response.headers())
+    {
+        return Err(io::Error::other("cc-lb-local workspace discovery was rejected"));
+    }
+    let discovery: LocalWorkspaceDiscovery = read_response(response).await?;
+    validate_workspace_discovery(&discovery, session)?;
+    if store.read()?.as_ref() != Some(session) {
+        return Err(io::Error::new(
+            io::ErrorKind::Interrupted,
+            "cc-lb-local session changed during workspace discovery",
+        ));
+    }
+    Ok(discovery)
+}
+
+pub async fn list_workspaces(
+    home: &Path,
+    profile: &CcLbConfig,
+    route: &AuthRouteConfig,
+    expected_access: &str,
+) -> io::Result<LocalWorkspaceDiscovery> {
+    let store = LocalSessionStore::new(home, profile)?;
+    let _operation = store.operation_guard().await?;
+    let session = store.read()?.ok_or_else(invalid_session)?;
+    if session.access_token != expected_access {
+        return Err(io::Error::new(
+            io::ErrorKind::Interrupted,
+            "cc-lb-local session changed before workspace discovery",
+        ));
+    }
+    discover_workspaces(&store, route, &session).await
+}
+
+
+pub(super) async fn switch_workspace(home: &Path, profile: &CcLbConfig, route: &AuthRouteConfig, expected_access: &str, workspace: &str) -> io::Result<AuthDotJson> {
+    let store = LocalSessionStore::new(home, profile)?;
+    let _operation = store.operation_guard().await?;
+    let previous = store.read()?.ok_or_else(invalid_session)?;
+    if previous.access_token != expected_access {
+        return Err(io::Error::new(io::ErrorKind::Interrupted, "cc-lb-local session changed before workspace exchange"));
+    }
+    let discovery = discover_workspaces(&store, route, &previous).await?;
+    if !discovery.workspaces.iter().any(|candidate| candidate.workspace_id == workspace) {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "cc-lb-local workspace target is not available",
+        ));
+    }
+    let response = client(route.http_client_factory().clone())
+        .post(format!("{}/backend-api/accounts/switch-workspace-token", store.profile.origin))
+        .header(http::header::AUTHORIZATION, format!("Bearer {}", previous.access_token))
+        .json(&serde_json::json!({"workspace_id":workspace}))
+        .timeout(Duration::from_secs(30)).send().await.map_err(|_| io::Error::other("cc-lb-local workspace exchange transport failed"))?;
+    if response.status() != http::StatusCode::OK {
+        return Err(io::Error::other(format!("cc-lb-local workspace exchange rejected (HTTP {})", response.status())));
+    }
+    let updated: WorkspaceResponse = read_response(response).await?;
+    let updated = selected_workspace_session(&store.profile, &previous, &discovery, updated, workspace)?;
+    store.compare_and_write(&previous, &updated)?;
+    updated.auth_json()
+}
+
+fn selected_workspace_session(
+    profile: &CcLbConfig,
+    previous: &LocalSession,
+    discovery: &LocalWorkspaceDiscovery,
+    response: WorkspaceResponse,
+    workspace: &str,
+) -> io::Result<LocalSession> {
+    validate_workspace_discovery(discovery, previous)?;
+    if !discovery.workspaces.iter().any(|candidate| candidate.workspace_id == workspace)
+        || response.workspace_generation <= discovery.workspace_generation
+    {
+        return Err(invalid_session());
+    }
+    let expiration = crate::token_data::parse_jwt_expiration(&response.access_token)
+        .map_err(|_| invalid_session())?.ok_or_else(invalid_session)?.timestamp();
+    let updated = LocalSession {
+        access_token: response.access_token,
+        expires_at: expiration,
+        account_id: workspace.to_owned(),
+        workspace_generation: response.workspace_generation,
+        ..previous.clone()
+    };
+    updated.validate(profile)?;
+    Ok(updated)
+}
