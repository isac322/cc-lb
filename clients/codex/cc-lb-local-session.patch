+        AbsolutePathBuf::from_absolute_path(codex_home.path())?,
+    ).await?;
+    assert_eq!(config.chatgpt_base_url, "https://proxy.example/backend-api");
+    assert_eq!(config.model_provider.base_url.as_deref(), Some("https://proxy.example/backend-api/codex"));
+    assert_eq!(config.cc_lb.as_ref().unwrap().origin, "https://proxy.example");
+    assert!(config.http_client_factory().rejects_redirects());
+    assert!(config.auth_route_config().http_client_factory().rejects_redirects());
+    // A route cached before the profile applied must not reopen redirects.
+    config.application_auth_route_config = Some(
+        codex_login::AuthRouteConfig::from_http_client_factory(
+            codex_http_client::HttpClientFactory::new(
+                codex_http_client::OutboundProxyPolicy::ReqwestDefault,
+            ),
+        ),
+    );
+    assert!(config.auth_route_config().http_client_factory().rejects_redirects());
+    // Vendor mode keeps its existing redirect behavior for both branches.
+    config.cc_lb = None;
+    assert!(!config.http_client_factory().rejects_redirects());
+    assert!(!config.auth_route_config().http_client_factory().rejects_redirects());
+    Ok(())
+}
