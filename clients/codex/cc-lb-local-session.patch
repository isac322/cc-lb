diff --git a/codex-rs/config/src/cc_lb.rs b/codex-rs/config/src/cc_lb.rs
new file mode 100644
index 0000000000..41636a65a0
--- /dev/null
+++ b/codex-rs/config/src/cc_lb.rs
@@ -0,0 +1,202 @@
+use schemars::JsonSchema;
+use serde::Deserialize;
+use serde::Serialize;
+use std::io;
+use url::Url;
+
+/// An explicit local-session destination and private credential profile.
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, Eq, JsonSchema)]
+#[schemars(deny_unknown_fields)]
+pub struct CcLbConfig {
+    pub origin: String,
+    #[serde(default = "default_profile")]
+    pub profile: String,
+}
+
+fn default_profile() -> String {
+    "default".to_string()
+}
+
+/// Marks a rejected profile so callers can refuse to degrade to another destination.
+#[derive(Debug)]
+struct CcLbConfigError(&'static str);
+
+impl std::fmt::Display for CcLbConfigError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(self.0)
+    }
+}
+
+impl std::error::Error for CcLbConfigError {}
+
+fn invalid(message: &'static str) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidInput, CcLbConfigError(message))
+}
+
+impl CcLbConfig {
+    pub fn normalized(&self) -> io::Result<Self> {
+        let url = parse_destination(&self.origin)?;
+        // Inspect the original path too: URL parsing normalizes dot segments.
+        let authority_and_path = self.origin.split_once("://").ok_or_else(|| {
+            invalid("cc_lb.origin must be an HTTPS origin")
+        })?.1;
+        let path = authority_and_path.find('/').map(|index| &authority_and_path[index..]);
+        if !matches!(path, None | Some("/")) || url.path() != "/" {
+            return Err(invalid("cc_lb.origin must not contain a path"));
+        }
+        if self.profile.is_empty()
+            || self.profile.len() > 64
+            || !self.profile.bytes().all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'_' | b'-'))
+        {
+            return Err(invalid("cc_lb.profile must contain 1 to 64 ASCII letters, digits, underscores, or hyphens"));
+        }
+        Ok(Self {
+            origin: url.origin().ascii_serialization(),
+            profile: self.profile.clone(),
+        })
+    }
+
+    /// Call on the normalized configuration returned by `normalized`.
+    pub fn backend_base(&self) -> String {
+        format!("{}/backend-api", self.origin.trim_end_matches('/'))
+    }
+
+    /// Call on the normalized configuration returned by `normalized`.
+    pub fn model_base(&self) -> String {
+        format!("{}/backend-api/codex", self.origin.trim_end_matches('/'))
+    }
+
+    /// Reject every destination override before reading a saved credential.
+    pub fn validate_destinations(
+        &self,
+        openai_base_url: Option<&str>,
+        chatgpt_base_url: Option<&str>,
+    ) -> io::Result<()> {
+        let config = self.normalized()?;
+        if let Some(value) = openai_base_url {
+            config.validate_destination(value, &config.model_base())?;
+        }
+        if let Some(value) = chatgpt_base_url {
+            config.validate_destination(value, &config.backend_base())?;
+        }
+        for (name, expected) in [
+            ("CODEX_CLOUD_TASKS_BASE_URL", config.backend_base()),
+            ("CODEX_REFRESH_TOKEN_URL_OVERRIDE", format!("{}/oauth/token", config.origin)),
+            ("CODEX_REVOKE_TOKEN_URL_OVERRIDE", format!("{}/oauth/revoke", config.origin)),
+        ] {
+            match std::env::var(name) {
+                Ok(value) => config.validate_destination(&value, &expected)?,
+                Err(std::env::VarError::NotPresent) => {}
+                Err(std::env::VarError::NotUnicode(_)) => {
+                    return Err(invalid("cc-lb destination override must be valid Unicode"));
+                }
+            }
+        }
+        Ok(())
+    }
+
+    /// Compare complete canonical destinations, not host names or string prefixes.
+    pub fn validate_destination(&self, actual: &str, expected: &str) -> io::Result<()> {
+        let actual = parse_destination(actual)?;
+        let expected = parse_destination(expected)?;
+        if actual.as_str().trim_end_matches('/') != expected.as_str().trim_end_matches('/') {
+            return Err(invalid("destination conflicts with the configured cc-lb origin"));
+        }
+        Ok(())
+    }
+
+    /// Reports a setting that cannot be combined with a cc-lb profile.
+    pub fn conflict(message: &'static str) -> io::Error {
+        invalid(message)
+    }
+
+    /// Whether `error` reports a rejected cc-lb profile rather than unreadable settings.
+    pub fn is_validation_error(error: &io::Error) -> bool {
+        error
+            .get_ref()
+            .is_some_and(|inner| inner.is::<CcLbConfigError>())
+    }
+}
+
+fn parse_destination(input: &str) -> io::Result<Url> {
+    let invalid_url = || invalid("cc-lb destinations must use HTTPS without user information, a query, or a fragment");
+    if input.trim() != input || input.bytes().any(|byte| byte.is_ascii_control() || byte == b'\\') {
+        return Err(invalid_url());
+    }
+    let url = Url::parse(input).map_err(|_| invalid_url())?;
+    let authority = input.split_once("://").map(|(_, rest)| rest.split('/').next().unwrap_or(rest));
+    if url.scheme() != "https"
+        || url.host_str().is_none()
+        || !url.username().is_empty()
+        || url.password().is_some()
+        || authority.is_some_and(|authority| authority.contains('@'))
+        || url.query().is_some()
+        || url.fragment().is_some()
+    {
+        return Err(invalid_url());
+    }
+    Ok(url)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn config(origin: &str) -> CcLbConfig {
+        CcLbConfig { origin: origin.to_string(), profile: default_profile() }
+    }
+
+    #[test]
+    fn normalizes_origin_and_derives_separate_bases() {
+        let normalized = config("https://Proxy.Example:443/").normalized().unwrap();
+        assert_eq!(normalized.origin, "https://proxy.example");
+        assert_eq!(normalized.backend_base(), "https://proxy.example/backend-api");
+        assert_eq!(normalized.model_base(), "https://proxy.example/backend-api/codex");
+        assert_eq!(config("https://proxy.example:8443").normalized().unwrap().origin, "https://proxy.example:8443");
+    }
+
+    #[test]
+    fn rejects_non_origins() {
+        for origin in ["http://proxy.example", "https://user@proxy.example", "https://@proxy.example", "https://proxy.example/a", "https://proxy.example/a/..", "https://proxy.example/?x", "https://proxy.example/#x", "https://proxy.example\\evil", " https://proxy.example"] {
+            assert!(config(origin).normalized().is_err(), "{origin}");
+        }
+    }
+
+    #[test]
+    fn omitted_profile_defaults_and_invalid_profiles_fail() {
+        let parsed: CcLbConfig = toml::from_str("origin = 'https://proxy.example'").unwrap();
+        assert_eq!(parsed.profile, "default");
+        for profile in ["", "../other", "a b", "a/b", "é"] {
+            let mut candidate = config("https://proxy.example");
+            candidate.profile = profile.to_string();
+            assert!(candidate.normalized().is_err());
+        }
+        let mut candidate = config("https://proxy.example");
+        candidate.profile = "a".repeat(65);
+        assert!(candidate.normalized().is_err());
+    }
+
+    #[test]
+    fn destination_equality_is_canonical_and_exact() {
+        let config = config("https://proxy.example").normalized().unwrap();
+        assert!(config.validate_destination("https://PROXY.example:443/backend-api/", &config.backend_base()).is_ok());
+        for destination in ["https://proxy.example/backend-api/codex", "https://proxy.example:8443/backend-api", "https://other.example/backend-api", "https://proxy.example/backend-api?x", "https://user@proxy.example/backend-api"] {
+            assert!(config.validate_destination(destination, &config.backend_base()).is_err(), "{destination}");
+        }
+    }
+
+    #[test]
+    fn rejected_profiles_are_distinguishable_from_other_io_errors() {
+        let rejected = config("http://proxy.example").normalized().unwrap_err();
+        assert_eq!(rejected.kind(), io::ErrorKind::InvalidInput);
+        assert!(CcLbConfig::is_validation_error(&rejected));
+        assert!(CcLbConfig::is_validation_error(&CcLbConfig::conflict("conflict")));
+        assert!(!CcLbConfig::is_validation_error(&io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "conflict",
+        )));
+        assert!(!CcLbConfig::is_validation_error(&io::Error::from(
+            io::ErrorKind::NotFound
+        )));
+    }
+}
