+#[test]
+fn websocket_unauthorized_errors_keep_bedrock_recovery_and_signature_guidance() {
+    let provider = AmazonBedrockModelProvider::new(
+        ModelProviderInfo::create_amazon_bedrock_provider(/*aws*/ None),
+        /*auth_manager*/ None,
+    );
+    let advice = RetryAfter::from_delay(Duration::from_secs(10)).expect("retry advice");
+    for error in [
+        TransportError::WebSocketHandshake {
+            status: StatusCode::UNAUTHORIZED,
+            url: Some(BEDROCK_RESPONSES_URL.to_string()),
+            headers: None,
+            body: Some("Signature expired: old is now earlier than new".to_string()),
+            raw_body: None,
+            retry_after: Some(advice),
+        },
+        TransportError::InBandHttp {
+            status: StatusCode::UNAUTHORIZED,
+            url: None,
+            headers: None,
+            body: Some(
+                serde_json::json!({
+                    "type": "error",
+                    "status": 401,
+                    "error": {"message": "Signature expired: old is now earlier than new"},
+                })
+                .to_string(),
+            ),
+            raw_body: None,
+            retry_after: Some(advice),
+        },
+    ] {
+        assert!(provider.is_recoverable_auth_error(&error), "{error:?}");
+        let mapped = provider.map_api_error(ApiError::Transport(error));
+        let CodexErrorDetails::UnexpectedStatus(response) = mapped.details() else {
+            panic!("expected Bedrock unauthorized response, got {mapped:?}");
+        };
+        assert_eq!(
+            response.user_message.as_deref(),
+            Some(BEDROCK_EXPIRED_SIGNATURE_MESSAGE)
+        );
+        assert_eq!(mapped.retry_after(), Some(advice));
+    }
+}
