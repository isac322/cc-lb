+#[tokio::test]
+async fn http_error_keeps_invalid_utf8_body_bytes() {
+    use std::io::Read;
+    // Invalid UTF-8 that is not a byte-order mark, so the text view is plain replacement.
+    const BODY: [u8; 3] = [0x80, b'A', 0xff];
+    for streaming in [false, true] {
+        let listener = std::net::TcpListener::bind("127.0.0.1:0").expect("test listener");
+        let address = listener.local_addr().expect("test address");
+        let server = std::thread::spawn(move || {
+            let (mut socket, _) = listener.accept().expect("accepted connection");
+            socket
+                .set_read_timeout(Some(Duration::from_secs(5)))
+                .expect("read timeout");
+            let mut request = Vec::new();
+            let mut byte = [0_u8; 1];
+            while !request.ends_with(b"\r\n\r\n") {
+                socket.read_exact(&mut byte).expect("request headers");
+                request.push(byte[0]);
+            }
+            socket
+                .write_all(
+                    b"HTTP/1.1 401 Unauthorized\r\nContent-Length: 3\r\nConnection: close\r\n\r\n",
+                )
+                .expect("response head");
+            socket.write_all(&BODY).expect("response body");
+            socket.flush().expect("response flushed");
+        });
+        let transport = ReqwestTransport::from_http_client(HttpClient::new(test_reqwest_client()));
+        let mut request = Request::new(Method::GET, format!("http://{address}/responses"));
+        request.timeout = Some(Duration::from_secs(5));
+        let error = if streaming {
+            match transport.stream(request).await {
+                Err(error) => error,
+                Ok(_) => panic!("expected 401"),
+            }
+        } else {
+            match transport.execute(request).await {
+                Err(error) => error,
+                Ok(_) => panic!("expected 401"),
+            }
+        };
+        server.join().expect("server finished");
+        let TransportError::Http {
+            status,
+            body,
+            raw_body,
+            ..
+        } = error
+        else {
+            panic!("expected an HTTP error response");
+        };
+        assert_eq!(status, StatusCode::UNAUTHORIZED);
+        assert_eq!(raw_body.as_deref(), Some(BODY.as_slice()));
+        // The text view keeps each path's existing decoding; only the byte view is exact.
+        assert_eq!(
+            body,
+            if streaming {
+                Some("\u{fffd}A\u{fffd}".to_string())
+            } else {
+                None
+            }
+        );
+    }
+}
