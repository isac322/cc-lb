index 3d25037697..721772b2ed 100644
--- a/codex-rs/app-server-client/src/lib.rs
+++ b/codex-rs/app-server-client/src/lib.rs
@@ -953,6 +953,34 @@ mod tests {
         }
     }
 
+    #[tokio::test]
+    async fn native_cloud_rejects_cc_lb_before_credential_io() {
+        let home = TempDir::new().expect("temp home");
+        let mut config = build_test_config_for_codex_home(home.path()).await;
+        let invalid_home = home.path().join("not-a-directory");
+        std::fs::write(&invalid_home, b"not a credential directory").expect("invalid home fixture");
+        config.codex_home = AbsolutePathBuf::from_absolute_path(invalid_home).expect("absolute path");
+        config.cli_auth_credentials_store_mode = codex_config::types::AuthCredentialsStoreMode::File;
+        config.cc_lb = Some(codex_config::CcLbConfig {
+            origin: "https://proxy.example".to_string(),
+            profile: "default".to_string(),
+        });
+
+        // Credential access would encounter a non-directory, and no credential
+        // can be obtained for a vendor request. The local guard must win first.
+        let local_error = cloud_backend::connect(&config).await.err()
+            .expect("native Cloud does not accept a cc-lb session");
+        let guard = "The cloud conversation preview does not have a cc-lb transport mapping.";
+        assert_eq!(local_error.to_string(), guard);
+
+        // Ordinary vendor mode still reaches its existing authentication path,
+        // which fails locally with this deliberately unusable credential home.
+        config.cc_lb = None;
+        let vendor_error = cloud_backend::connect(&config).await.err()
+            .expect("an invalid credential home cannot connect");
+        assert_ne!(vendor_error.to_string(), guard);
+    }
+
     struct TestClient {
         _codex_home: TempDir,
         client: InProcessAppServerClient,
