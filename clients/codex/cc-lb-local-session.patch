+        &self,
+        rejected_headers: HeaderMap,
+    ) -> codex_api::AuthRefreshFuture<'_> {
+        if self.auth_manager.cc_lb_origin().is_some() {
+            return Box::pin(async { false });
+        }
+        self.refresh_rejected_headers(rejected_headers)
+    }
+
+    fn refresh_after_http_unauthorized(
+        &self,
+        rejected_headers: HeaderMap,
