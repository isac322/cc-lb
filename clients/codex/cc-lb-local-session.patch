+#[tokio::test]
+async fn status_local_identity_uses_server_metadata_not_host_config() {
+    let temp_home = TempDir::new().expect("temp home");
+    let mut config = test_config(&temp_home).await;
+    let now = chrono::Local.with_ymd_and_hms(2024, 1, 2, 3, 4, 5).single().expect("timestamp");
+    let usage = TokenUsage::default();
+    for local in [true, false] {
+        // A remote local session needs no host profile, and a host profile cannot
+        // relabel an independently connected vendor account.
+        config.cc_lb = (!local).then(|| codex_config::CcLbConfig {
+            origin: "https://proxy.example".to_string(),
+            profile: "default".to_string(),
+        });
+        let account = StatusAccountDisplay::ChatGpt {
+            email: (!local).then(|| "vendor@example.com".to_string()),
+            plan: None,
+            workspace: Some("workspace-alias".to_string()),
+            auth_source: local.then_some(codex_app_server_protocol::AccountAuthSource::CcLbLocal),
+        };
+        let output = new_status_output(
+            &config, Some(&account), None, &usage, &None, None, None, None,
+            None, now, "test-model", None, None,
+        );
+        let text = render_lines(&output.display_lines(100)).join("\n");
+        assert_eq!(text.contains("cc-lb-local"), local);
+        assert_eq!(text.contains("Local workspace"), local);
+        assert_eq!(text.contains("ChatGPT workspace"), !local);
+        assert_eq!(text.contains("Token usage"), local);
+        assert!(!local || !text.contains("vendor@example.com"));
+    }
+}
