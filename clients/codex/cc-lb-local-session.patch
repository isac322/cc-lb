+#[test]
+fn cc_lb_recovery_requires_expired_principal_from_explicit_origin() {
+    for (error_origin, reason, recoverable) in [
+        ("principal", Some("expired"), true),
+        ("principal", None, false),
+        ("upstream", None, false),
+        ("proxy", None, false),
+        ("relay", None, false),
+        ("renewal", None, false),
+        ("upstream", Some("expired"), false),
+    ] {
+        let mut headers = http::HeaderMap::new();
+        headers.insert("cc-lb-error-origin", http::HeaderValue::from_static(error_origin));
+        if let Some(reason) = reason {
+            headers.insert("cc-lb-auth-reason", http::HeaderValue::from_static(reason));
+        }
+        let provenance = codex_http_client::cc_lb_auth_provenance(
+            "https://proxy.example", Some("https://proxy.example/backend-api/accounts/check"),
+            http::StatusCode::UNAUTHORIZED, &headers,
+        );
+        let error = crate::RequestError::UnexpectedStatus {
+            method: "GET".to_owned(),
+            url: "https://proxy.example/backend-api/accounts/check".to_owned(),
+            status: http::StatusCode::UNAUTHORIZED,
+            content_type: "text/plain".to_owned(),
+            body: "original unauthorized body".to_owned(),
+            raw_body: None,
+            response_url: "https://proxy.example/backend-api/accounts/check".to_owned(),
+            identity_error_code: None,
+            headers,
+            retry_after: None,
+            cc_lb_origin: Some("https://proxy.example".to_owned()),
+            cc_lb_provenance: provenance,
+        };
+        assert_eq!(error.is_unauthorized(), recoverable, "{error_origin}");
+        assert_eq!(error.status(), Some(http::StatusCode::UNAUTHORIZED));
+        assert!(error.to_string().contains("original unauthorized body"));
+    }
+}
+
+#[test]
+fn vendor_unauthorized_recovery_does_not_require_cc_lb_headers() {
+    let error = crate::RequestError::UnexpectedStatus {
+        method: "GET".to_owned(),
+        url: "https://chatgpt.com/backend-api/accounts/check".to_owned(),
+        status: http::StatusCode::UNAUTHORIZED,
+        content_type: "text/plain".to_owned(),
+        body: "vendor unauthorized".to_owned(),
+        raw_body: None,
+        response_url: "https://chatgpt.com/backend-api/accounts/check".to_owned(),
+        identity_error_code: None,
+        headers: http::HeaderMap::new(),
+        retry_after: None,
+        cc_lb_origin: None,
+        cc_lb_provenance: None,
+    };
+    assert!(error.is_unauthorized());
+}
+
+#[tokio::test]
+async fn unexpected_status_keeps_invalid_utf8_body_bytes() {
+    let provider_body = vec![0x80, b'A', 0xff];
+    let server = MockServer::start().await;
+    Mock::given(method("GET"))
+        .and(path("/api/codex/accounts/check"))
+        .respond_with(ResponseTemplate::new(401).set_body_bytes(provider_body.clone()))
+        .expect(1)
+        .mount(&server)
+        .await;
+    let client = Client::new(
+        server.uri(),
+        HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+    );
+    let error = client.get_accounts_check().await.unwrap_err();
+    let RequestError::UnexpectedStatus {
+        status,
+        body,
+        raw_body,
+        ..
+    } = error
+    else {
+        panic!("expected the unauthorized response");
+    };
+    assert_eq!(status, StatusCode::UNAUTHORIZED);
+    assert_eq!(raw_body.as_deref(), Some(provider_body.as_slice()));
+    assert_eq!(body, "\u{fffd}A\u{fffd}");
+    server.verify().await;
+}
