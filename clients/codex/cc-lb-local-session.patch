+#[tokio::test]
+async fn cc_lb_provenance_uses_actual_tls_response_not_request_url_or_payload() {
+    use std::io::Read;
+    codex_utils_rustls_provider::ensure_rustls_crypto_provider();
+    for streaming in [false, true] {
+        for (reserved_headers, refresh) in [
+            ("Cc-Lb-Error-Origin: principal\r\nCc-Lb-Auth-Reason: expired\r\n", true),
+            ("Cc-Lb-Error-Origin: upstream\r\n", false),
+            ("Cc-Lb-Error-Origin: principal\r\nCc-Lb-Error-Origin: principal\r\nCc-Lb-Auth-Reason: expired\r\n", false),
+        ] {
+            let certificate = rcgen::generate_simple_self_signed(vec!["127.0.0.1".to_owned()])
+                .expect("test certificate");
+            let root = reqwest::Certificate::from_der(certificate.cert.der()).expect("test root");
+            let key = rustls::pki_types::PrivateKeyDer::Pkcs8(
+                rustls::pki_types::PrivatePkcs8KeyDer::from(certificate.signing_key.serialize_der()),
+            );
+            let tls_config = Arc::new(rustls::ServerConfig::builder()
+                .with_no_client_auth()
+                .with_single_cert(vec![certificate.cert.der().clone()], key)
+                .expect("TLS config"));
+            let listener = std::net::TcpListener::bind("127.0.0.1:0").expect("test listener");
+            let address = listener.local_addr().expect("test address");
+            let origin = format!("https://{address}");
+            let redirected_url = format!("{origin}/actual-response");
+            let location = redirected_url.clone();
+            let server = std::thread::spawn(move || {
+                for redirect in [true, false] {
+                    let (socket, _) = listener.accept().expect("accepted TLS connection");
+                    socket.set_read_timeout(Some(Duration::from_secs(5))).expect("read timeout");
+                    socket.set_write_timeout(Some(Duration::from_secs(5))).expect("write timeout");
+                    let connection = rustls::ServerConnection::new(tls_config.clone())
+                        .expect("TLS connection");
+                    let mut stream = rustls::StreamOwned::new(connection, socket);
+                    let mut request = Vec::new();
+                    let mut byte = [0_u8; 1];
+                    while !request.ends_with(b"\r\n\r\n") {
+                        stream.read_exact(&mut byte).expect("request headers");
+                        request.push(byte[0]);
+                    }
+                    let response = if redirect {
+                        format!("HTTP/1.1 302 Found\r\nLocation: {location}\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
+                    } else {
+                        format!("HTTP/1.1 401 Unauthorized\r\n{reserved_headers}Retry-After: 7\r\nContent-Length: 13\r\nConnection: close\r\n\r\nupstream body")
+                    };
+                    stream.write_all(response.as_bytes()).expect("HTTP response");
+                    stream.flush().expect("response flushed");
+                }
+            });
+            let client = reqwest::Client::builder().no_proxy().add_root_certificate(root)
+                .timeout(Duration::from_secs(5)).build().expect("test client");
+            let transport = ReqwestTransport::new(client);
+            let request = Request::new(Method::GET, format!("{origin}/initial-request"));
+            let error = if streaming {
+                match transport.stream(request).await {
+                    Err(error) => error,
+                    Ok(_) => panic!("expected 401"),
+                }
+            } else {
+                match transport.execute(request).await {
+                    Err(error) => error,
+                    Ok(_) => panic!("expected 401"),
+                }
+            };
+            server.join().expect("server finished");
+            assert_eq!(error.cc_lb_auth_provenance(&origin)
+                .is_some_and(|value| value.allows_principal_refresh()), refresh);
+            assert!(error.cc_lb_auth_provenance("https://other.example").is_none());
+            let TransportError::Http { status, url, body, retry_after, .. } = error else {
+                panic!("expected actual HTTP response provenance");
+            };
+            assert_eq!(status, StatusCode::UNAUTHORIZED);
+            assert_eq!(url.as_deref(), Some(redirected_url.as_str()));
+            assert_eq!(body.as_deref(), Some("upstream body"));
+            assert_eq!(retry_after, RetryAfter::from_delay(Duration::from_secs(7)));
+        }
+    }
+}
