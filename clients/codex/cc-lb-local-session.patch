+    let local = ConfigToml {
+        cc_lb: Some(codex_config::CcLbConfig {
+            origin: "https://proxy.example".to_string(),
+            profile: "default".to_string(),
+        }),
+        ..Default::default()
+    };
+    assert!(
+        resolve_bootstrap_http_client_factory(&local, /*feature_requirements*/ None)?
+            .rejects_redirects()
+    );
+    assert!(
+        resolve_bootstrap_auth_route_config(&local, /*feature_requirements*/ None)?
+            .http_client_factory()
+            .rejects_redirects()
+    );
+    let vendor = ConfigToml::default();
+    assert!(
+        !resolve_bootstrap_http_client_factory(&vendor, /*feature_requirements*/ None)?
+            .rejects_redirects()
+    );
+    assert!(
+        !resolve_bootstrap_auth_route_config(&vendor, /*feature_requirements*/ None)?
+            .http_client_factory()
+            .rejects_redirects()
+    );
+    Ok(())
+}
