@@ -14,12 +14,53 @@ pub enum CloudTaskError {
     Unimplemented(&'static str),
     #[error("http error: {0}")]
     Http(String),
+    /// A cc-lb backend response, kept typed so recovery can check its transport provenance.
+    #[error("http error: {0}")]
+    Backend(BackendFailure),
     #[error("io error: {0}")]
     Io(String),
     #[error("{0}")]
     Msg(String),
 }
 
+/// A failed backend call that still carries the typed response it failed with.
+#[derive(Debug)]
+pub struct BackendFailure {
+    operation: &'static str,
+    source: anyhow::Error,
+}
+
+impl std::fmt::Display for BackendFailure {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "{} failed: {}", self.operation, self.source)
+    }
+}
+
+impl CloudTaskError {
+    /// Keeps a cc-lb response typed; every other failure is the same message as before.
+    pub(crate) fn backend(operation: &'static str, source: anyhow::Error) -> Self {
+        let cc_lb_response = matches!(
+            source.downcast_ref::<codex_backend_client::RequestError>(),
+            Some(codex_backend_client::RequestError::UnexpectedStatus {
+                cc_lb_origin: Some(_),
+                ..
+            })
+        );
+        if cc_lb_response {
+            Self::Backend(BackendFailure { operation, source })
+        } else {
+            Self::Http(format!("{operation} failed: {source}"))
+        }
+    }
+
+    pub fn backend_request_error(&self) -> Option<&codex_backend_client::RequestError> {
+        match self {
+            Self::Backend(failure) => failure.source.downcast_ref(),
+            _ => None,
+        }
+    }
+}
