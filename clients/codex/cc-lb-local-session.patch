+    let codex_home = tempdir()?;
+    let mut config = Config::load_from_base_config_with_overrides(
+        ConfigToml {
+            cc_lb: Some(codex_config::CcLbConfig {
+                origin: "https://Proxy.Example:443/".to_string(),
+                profile: "default".to_string(),
+            }),
