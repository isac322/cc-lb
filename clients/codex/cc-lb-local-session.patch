+                codex_api::TransportError::Http { status, .. }
+                    | codex_api::TransportError::WebSocketHandshake { status, .. }
+                    | codex_api::TransportError::InBandHttp { status, .. }
+                    if *status == http::StatusCode::UNAUTHORIZED
+            ),
+        };
+        if !allowed {
+            return Box::pin(async { false });
+        }
+        self.refresh_rejected_headers(rejected_headers)
