+
+    /// Retries a local cc-lb request at most once, only after transport-proven principal expiry.
+    async fn send_with_local_auth_recovery(
+        &self,
+        mut params: HttpRequestParams,
+        maximum_body_bytes: Option<usize>,
+        provider: Option<codex_api::SharedAuthProvider>,
+    ) -> Result<
+        (codex_exec_server::HttpRequestResponse, HttpResponseBodyStream),
+        StreamableHttpError<StreamableHttpClientAdapterError>,
+    > {
+        let local_provider = provider.as_ref().filter(|provider| provider.cc_lb_origin().is_some());
+        if local_provider.is_some() {
+            let origin = local_provider.and_then(|provider| provider.cc_lb_origin())
+                .expect("local provider has a configured origin");
+            let destination = url::Url::parse(&params.url).map_err(|_| {
+                StreamableHttpError::Client(StreamableHttpClientAdapterError::Header(
+                    "invalid local Apps MCP destination".to_owned(),
+                ))
+            })?;
+            let expected = url::Url::parse(origin).map_err(|_| {
+                StreamableHttpError::Client(StreamableHttpClientAdapterError::Header(
+                    "invalid local Apps MCP origin".to_owned(),
+                ))
+            })?;
+            if destination.scheme() != "https"
+                || destination.origin() != expected.origin()
+                || !destination.username().is_empty()
+                || destination.password().is_some()
+                || destination.path() != "/backend-api/ps/mcp"
+                || destination.query().is_some()
+                || destination.fragment().is_some()
+            {
+                return Err(StreamableHttpError::Client(
+                    StreamableHttpClientAdapterError::Header(
+                        "local Apps MCP destination does not match configured origin".to_owned(),
+                    ),
+                ));
+            }
+            params.redirect_policy = HttpRedirectPolicy::Stop;
+        }
+        let retry_params = local_provider.map(|_| params.clone());
+        let (response, mut stream) = self
+            .http_client
+            .http_request_stream(params)
+            .await
+            .map_err(StreamableHttpClientAdapterError::from)
+            .map_err(StreamableHttpError::Client)?;
+        let Some(provider) = local_provider else {
+            return Ok((response, stream));
+        };
+        // Only an unauthorized response can prove principal expiry. Every other status, and an
+        // unauthorized response that does not prove it, continues through the ordinary MCP
+        // handling with its original status, headers and body.
+        if response.status != StatusCode::UNAUTHORIZED.as_u16() {
+            return Ok((response, stream));
+        }
+        let request_headers = response_headers_map(
+            &retry_params.as_ref().expect("local retry parameters").headers,
+        )?;
+        let error = local_http_error(&response, &mut stream, maximum_body_bytes).await?;
+        if !provider
+            .refresh_after_http_unauthorized(request_headers, &error)
+            .await
+        {
+            let body = match error {
+                codex_http_client::TransportError::Http { raw_body, .. }
+                | codex_http_client::TransportError::InBandHttp { raw_body, .. } => raw_body,
+                _ => None,
+            };
+            let stream =
+                HttpResponseBodyStream::from_chunks(body.map(Vec::from).into_iter().collect());
+            return Ok((response, stream));
+        }
+
+        let mut params = retry_params.expect("local provider retained one bounded retry");
+        let retry_headers = response_headers_map(&params.headers)?;
+        let retry_headers = provider
+            .apply_auth_headers(retry_headers)
+            .await
+            .map_err(StreamableHttpClientAdapterError::from)
+            .map_err(StreamableHttpError::Client)?;
+        params.headers = protocol_headers(&retry_headers);
+        self.http_client
+            .http_request_stream(params)
+            .await
+            .map_err(StreamableHttpClientAdapterError::from)
+            .map_err(StreamableHttpError::Client)
+    }
+}
+
+fn response_headers_map(
+    headers: &[HttpHeader],
+) -> Result<HeaderMap, StreamableHttpError<StreamableHttpClientAdapterError>> {
+    let mut result = HeaderMap::new();
+    for header in headers {
+        let name = HeaderName::from_bytes(header.name.as_bytes()).map_err(|_| {
+            StreamableHttpError::Client(StreamableHttpClientAdapterError::Header(
+                "invalid response header name".to_owned(),
+            ))
+        })?;
+        let value = HeaderValue::from_str(&header.value).map_err(|_| {
+            StreamableHttpError::Client(StreamableHttpClientAdapterError::Header(
+                "invalid response header value".to_owned(),
+            ))
+        })?;
+        result.append(name, value);
+    }
+    Ok(result)
+}
+
+async fn local_http_error(
+    response: &codex_exec_server::HttpRequestResponse,
+    stream: &mut HttpResponseBodyStream,
+    maximum_body_bytes: Option<usize>,
+) -> Result<codex_http_client::TransportError, StreamableHttpError<StreamableHttpClientAdapterError>> {
+    let status = StatusCode::from_u16(response.status).map_err(|_| {
+        StreamableHttpError::UnexpectedServerResponse("invalid HTTP response status".into())
+    })?;
+    let url = stream.actual_response_url().map(str::to_owned);
+    let source = stream.actual_response_source();
+    let headers = response_headers_map(&response.headers)?;
+    let retry_after = codex_http_client::RetryAfter::from_headers(&headers);
+    let raw_body = codex_http_client::HttpBodyBytes::from(
+        collect_body(stream, Some(maximum_body_bytes.unwrap_or(MAX_MCP_STDIO_LINE_BYTES))).await?,
+    );
+    let body = String::from_utf8(raw_body.to_vec()).ok();
+    Ok(match source {
+        codex_http_client::CcLbResponseSource::HttpResponse => codex_http_client::TransportError::Http {
+            status,
+            url,
+            headers: Some(headers),
+            body,
+            raw_body: Some(raw_body),
+            retry_after,
+        },
+        _ => codex_http_client::TransportError::InBandHttp {
+            status,
+            url,
+            headers: Some(headers),
+            body,
+            raw_body: Some(raw_body),
+            retry_after,
+        },
+    })
 }
 
