+#[test]
+fn cc_lb_http_error_context_preserves_source_body_status_and_retry_advice() {
+    let expected_origin = "https://proxy.example";
+    let mut headers = http::HeaderMap::new();
+    headers.insert("cc-lb-error-origin", http::HeaderValue::from_static("upstream"));
+    headers.insert("retry-after", http::HeaderValue::from_static("7"));
+    let retry_after = codex_http_client::RetryAfter::from_headers(&headers);
+    for source in [
+        codex_http_client::CcLbResponseSource::HttpResponse,
+        codex_http_client::CcLbResponseSource::WebSocketHandshake,
+        codex_http_client::CcLbResponseSource::InBand,
+    ] {
+        let status = http::StatusCode::UNAUTHORIZED;
+        let url = Some(format!("{expected_origin}/backend-api/codex/responses"));
+        let body = Some("original upstream unauthorized body".to_owned());
+        let transport = match source {
+            codex_http_client::CcLbResponseSource::HttpResponse => TransportError::Http {
+                raw_body: None,
+                status, url, headers: Some(headers.clone()), body, retry_after,
+            },
+            codex_http_client::CcLbResponseSource::WebSocketHandshake => TransportError::WebSocketHandshake {
+                raw_body: None,
+                status, url, headers: Some(headers.clone()), body, retry_after,
+            },
+            codex_http_client::CcLbResponseSource::InBand => TransportError::InBandHttp {
+                raw_body: None,
+                status, url, headers: Some(headers.clone()), body, retry_after,
+            },
+        };
+        let error = map_api_error(ApiError::Transport(transport));
+        let context = error.http_response_context().expect("preserved HTTP context");
+        assert_eq!(context.source, source);
+        assert_eq!(context.status, status);
+        assert_eq!(context.body.as_deref(), Some("original upstream unauthorized body"));
+        let provenance = context.cc_lb_auth_provenance(expected_origin);
+        assert_eq!(provenance.is_some(), source != codex_http_client::CcLbResponseSource::InBand);
+        assert!(!provenance.is_some_and(|value| value.allows_principal_refresh()));
+        let codex_protocol::error::CodexErrorDetails::UnexpectedStatus(response) = error.details() else {
+            panic!("upstream401 must keep its original response");
+        };
+        assert_eq!(response.status, status);
+        assert_eq!(response.body, "original upstream unauthorized body");
+    }
+}
