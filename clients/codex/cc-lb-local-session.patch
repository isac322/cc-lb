+    assert_eq!(tokens.id_token.chatgpt_user_id.as_deref(), Some("local-user"));
+    assert_eq!(tokens.id_token.email, None);
+    assert!(!tokens.id_token.chatgpt_account_is_fedramp);
+    assert_eq!(std::fs::read(home.path().join("auth.json")).unwrap(), b"vendor sentinel");
