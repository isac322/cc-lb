+++ b/codex-rs/login/src/auth/cc_lb.rs
@@ -0,0 +1,626 @@
+//! Explicit, origin-scoped cc-lb credentials. These are local sessions, not OpenAI identities.
+
+use super::manager::ChatgptAuth;
+use super::manager::ChatgptAuthState;
+use super::storage::AuthDotJson;
+use super::storage::AuthStorageBackend;
+use crate::AuthRouteConfig;
+use crate::CodexAuth;
+use crate::TokenData;
+use crate::token_data::parse_chatgpt_jwt_claims;
+use base64::Engine;
+use codex_config::CcLbConfig;
+use codex_http_client::ClientRouteClass;
+use codex_http_client::RouteAwareClientPool;
+use codex_protocol::auth::AuthMode;
+use serde::Deserialize;
+use serde::Serialize;
+use sha2::Digest;
+use sha2::Sha256;
+use std::fs::File;
+use std::fs::OpenOptions;
+use std::io;
+use std::io::Read;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::time::Duration;
+
+const MAX_SESSION_BYTES: u64 = 64 * 1024;
+
+#[derive(Clone, Deserialize, Serialize, PartialEq, Eq)]
+pub struct LocalSession {
+    pub session_id: String,
+    pub access_token: String,
+    pub renewal_token: String,
+    pub token_type: String,
+    pub expires_at: i64,
+    pub session_expires_at: i64,
+    pub origin: String,
+    pub account_id: String,
+    pub user_id: String,
+    pub workspace_generation: u64,
+}
+
+impl std::fmt::Debug for LocalSession {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("LocalSession")
+            .field("kind", &"cc-lb-local")
+            .field("origin", &self.origin)
+            .field("workspace_generation", &self.workspace_generation)
+            .finish_non_exhaustive()
+    }
+}
+
+#[derive(Deserialize)]
+struct LocalClaims {
+    iss: String,
+    aud: String,
+    sub: String,
+    sid: String,
+    exp: i64,
+}
+
+fn invalid_session() -> io::Error {
+    // Never attach parser diagnostics or response bodies: they may contain credentials.
+    io::Error::new(io::ErrorKind::InvalidData, "Invalid cc-lb-local session document")
+}
+
+impl LocalSession {
+    pub fn validate(&self, profile: &CcLbConfig) -> io::Result<()> {
+        let profile = profile.normalized()?;
+        if self.origin != profile.origin
+            || self.token_type != "Bearer"
+            || self.session_id.is_empty()
+            || self.account_id.is_empty()
+            || self.user_id.is_empty()
+            || self.expires_at <= 0
+            || self.expires_at > self.session_expires_at
+            || !self.renewal_token.starts_with("cclb-renew-v1.")
+        {
+            return Err(invalid_session());
+        }
+        let renewal = self.renewal_token.strip_prefix("cclb-renew-v1.").ok_or_else(invalid_session)?;
+        if base64::engine::general_purpose::URL_SAFE_NO_PAD.decode(renewal).map_err(|_| invalid_session())?.len() != 32 {
+            return Err(invalid_session());
+        }
+        let mut parts = self.access_token.split('.');
+        let (header_part, payload_part, secret_part) = match (parts.next(), parts.next(), parts.next(), parts.next()) {
+            (Some(header), Some(payload), Some(secret), None) if !header.is_empty() && !payload.is_empty() && !secret.is_empty() => (header, payload, secret),
+            _ => return Err(invalid_session()),
+        };
+        let decode = |value: &str| base64::engine::general_purpose::URL_SAFE_NO_PAD.decode(value).map_err(|_| invalid_session());
+        let header: serde_json::Value = serde_json::from_slice(&decode(header_part)?).map_err(|_| invalid_session())?;
+        if header != serde_json::json!({"typ":"cc-lb-session-v1","alg":"CCLB-STATEFUL"}) || decode(secret_part)?.len() != 32 {
+            return Err(invalid_session());
+        }
+        let claims: LocalClaims = serde_json::from_slice(&decode(payload_part)?).map_err(|_| invalid_session())?;
+        let metadata = parse_chatgpt_jwt_claims(&self.access_token).map_err(|_| invalid_session())?;
+        if claims.iss != self.origin || claims.aud != "cc-lb-session-v1" || claims.sub != self.user_id
+            || claims.sid != self.session_id || claims.exp != self.expires_at
+            || metadata.chatgpt_user_id.as_deref() != Some(self.user_id.as_str())
+            || metadata.chatgpt_account_id.as_deref() != Some(self.account_id.as_str())
+            || metadata.email.is_some() || metadata.chatgpt_account_is_fedramp
+        {
+            return Err(invalid_session());
+        }
+        Ok(())
+    }
+
+    fn auth_json(&self) -> io::Result<AuthDotJson> {
+        Ok(AuthDotJson {
+            auth_mode: Some(AuthMode::Chatgpt),
+            openai_api_key: None,
+            tokens: Some(TokenData {
+                id_token: parse_chatgpt_jwt_claims(&self.access_token).map_err(|_| invalid_session())?,
+                access_token: self.access_token.clone(),
+                refresh_token: self.renewal_token.clone(),
+                oauth_provenance: None,
+                login_owner_id: Some(self.session_id.clone()),
+                account_id: Some(self.account_id.clone()),
+            }),
+            last_refresh: None,
+            agent_identity: None,
+            personal_access_token: None,
+            bedrock_api_key: None,
+            bedrock_access_keys: None,
+        })
+    }
+}
+
+#[derive(Clone, Debug)]
+pub(super) struct LocalSessionStore {
+    profile: CcLbConfig,
+    directory: PathBuf,
+}
+
+impl LocalSessionStore {
+    pub(super) fn new(home: &Path, profile: &CcLbConfig) -> io::Result<Self> {
+        let profile = profile.normalized()?;
+        profile.validate_destinations(None, None)?;
+        let mut digest = Sha256::new();
+        digest.update(profile.origin.as_bytes());
+        digest.update([0]);
+        digest.update(profile.profile.as_bytes());
+        let key = format!("{:x}", digest.finalize());
+        Ok(Self { profile, directory: home.join("cc-lb").join(key) })
+    }
+
+    fn path(&self) -> PathBuf { self.directory.join("session.json") }
+
+    fn private_directory(path: &Path) -> io::Result<()> {
+        #[cfg(windows)]
+        codex_uds::prepare_private_directory(path)?;
+        let mut builder = std::fs::DirBuilder::new();
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::DirBuilderExt;
+            builder.mode(0o700);
+        }
+        match builder.create(path) {
+            Ok(()) => (),
+            Err(error) if error.kind() == io::ErrorKind::AlreadyExists => (),
+            Err(error) => return Err(error),
+        }
+        let metadata = std::fs::symlink_metadata(path)?;
+        if !metadata.is_dir() || metadata.file_type().is_symlink() {
+            return Err(io::Error::new(io::ErrorKind::PermissionDenied, "cc-lb-local storage must be a private directory"));
+        }
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            if metadata.permissions().mode() & 0o077 != 0 {
+                return Err(io::Error::new(io::ErrorKind::PermissionDenied, "cc-lb-local storage directory is not private"));
+            }
+        }
+        Ok(())
+    }
+
+    fn lock(&self) -> io::Result<File> {
+        Self::named_lock(&self.directory, "session.lock", Duration::from_secs(5))
+    }
+
+    fn named_lock(directory: &Path, name: &str, timeout: Duration) -> io::Result<File> {
+        let root = directory.parent().ok_or_else(invalid_session)?;
+        std::fs::create_dir_all(root.parent().ok_or_else(invalid_session)?)?;
+        Self::private_directory(root)?;
+        Self::private_directory(directory)?;
+        let path = directory.join(name);
+        match std::fs::symlink_metadata(&path) {
+            Ok(_) => Self::check_private_file(&path)?,
+            Err(error) if error.kind() == io::ErrorKind::NotFound => (),
+            Err(error) => return Err(error),
+        }
+        let mut options = OpenOptions::new();
+        options.read(true).write(true).create(true).truncate(false);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            options.mode(0o600);
+        }
+        let file = options.open(path)?;
+        let deadline = std::time::Instant::now() + timeout;
+        loop {
+            match file.try_lock() {
+                Ok(()) => return Ok(file),
+                Err(std::fs::TryLockError::WouldBlock) if std::time::Instant::now() < deadline => std::thread::sleep(Duration::from_millis(10)),
+                Err(std::fs::TryLockError::WouldBlock) => return Err(io::Error::new(io::ErrorKind::TimedOut, "cc-lb-local storage lock timed out")),
+                Err(error) => return Err(error.into()),
+            }
+        }
+    }
+
+    fn operation_lock(&self) -> io::Result<File> {
+        Self::named_lock(&self.directory, "operation.lock", Duration::from_secs(45))
+    }
+
+    async fn operation_guard(&self) -> io::Result<File> {
+        let directory = self.directory.clone();
+        tokio::task::spawn_blocking(move || Self::named_lock(&directory, "operation.lock", Duration::from_secs(45))).await
+            .map_err(|_| io::Error::other("cc-lb-local operation lock failed"))?
+    }
+
+
+    fn check_private_file(path: &Path) -> io::Result<()> {
+        let metadata = std::fs::symlink_metadata(path)?;
+        if !metadata.is_file() || metadata.file_type().is_symlink() {
+            return Err(io::Error::new(io::ErrorKind::PermissionDenied, "cc-lb-local credential file is not regular"));
+        }
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::MetadataExt;
+            use std::os::unix::fs::PermissionsExt;
+            if metadata.permissions().mode() & 0o077 != 0 || metadata.nlink() != 1 {
+                return Err(io::Error::new(io::ErrorKind::PermissionDenied, "cc-lb-local credential file is not private"));
+            }
+        }
+        Ok(())
+    }
+
+    pub(super) fn read(&self) -> io::Result<Option<LocalSession>> {
+        let path = self.path();
+        match std::fs::symlink_metadata(&path) {
+            Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(None),
+            Err(error) => return Err(error),
+            Ok(_) => (),
+        }
+        Self::private_directory(self.directory.parent().ok_or_else(invalid_session)?)?;
+        Self::private_directory(&self.directory)?;
+        Self::check_private_file(&path)?;
+        let session = read_session(File::open(path)?)?;
+        session.validate(&self.profile)?;
+        Ok(Some(session))
+    }
+
+    fn write(&self, session: &LocalSession) -> io::Result<()> {
+        session.validate(&self.profile)?;
+        let path = self.path();
+        if path.exists() { Self::check_private_file(&path)?; }
+        let mut file = super::storage::private_replacement(&path)?;
+        serde_json::to_writer(file.as_file_mut(), session).map_err(|_| invalid_session())?;
+        file.as_file_mut().flush()?;
+        file.as_file_mut().sync_all()?;
+        file.persist(path).map_err(|error| error.error)?;
+        Ok(())
+    }
+
+    fn compare_and_write(&self, expected: &LocalSession, updated: &LocalSession) -> io::Result<()> {
+        let _guard = self.lock()?;
+        if self.read()?.as_ref() != Some(expected) {
+            return Err(io::Error::new(io::ErrorKind::Interrupted, "cc-lb-local session changed during request"));
+        }
+        self.write(updated)
+    }
+}
+
+impl AuthStorageBackend for LocalSessionStore {
+    fn cc_lb_origin(&self) -> Option<&str> { Some(&self.profile.origin) }
+    fn load(&self) -> io::Result<Option<AuthDotJson>> { self.read()?.map(|session| session.auth_json()).transpose() }
+    fn save(&self, _auth: &AuthDotJson) -> io::Result<()> {
+        Err(io::Error::new(io::ErrorKind::Unsupported, "cc-lb-local credentials require a generation-checked session operation"))
+    }
+    fn delete(&self) -> io::Result<bool> {
+        if !self.directory.try_exists()? { return Ok(false); }
+        let _operation = self.operation_lock()?;
+        let _guard = self.lock()?;
+        match std::fs::remove_file(self.path()) {
+            Ok(()) => Ok(true),
+            Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(false),
+            Err(error) => Err(error),
+        }
+    }
+}
+
+fn read_session(reader: impl Read) -> io::Result<LocalSession> {
+    let mut bytes = Vec::new();
+    reader.take(MAX_SESSION_BYTES + 1).read_to_end(&mut bytes)?;
+    if bytes.len() as u64 > MAX_SESSION_BYTES { return Err(invalid_session()); }
+    // Derived struct deserialization rejects duplicate known fields; future fields are ignored.
+    serde_json::from_slice(&bytes).map_err(|_| invalid_session())
+}
+
+/// Import the no-store issuance response directly from a pipe or an authorized executor's memory.
+/// The caller must establish the issuance response's Cache-Control: no-store provenance.
+pub fn import_session(home: &Path, profile: &CcLbConfig, reader: impl Read) -> io::Result<()> {
+    let store = LocalSessionStore::new(home, profile)?;
+    let session = read_session(reader)?;
+    session.validate(&store.profile)?;
+    let _operation = store.operation_lock()?;
+    let _guard = store.lock()?;
+    if store.read()?.is_some() {
+        return Err(io::Error::new(io::ErrorKind::AlreadyExists, "cc-lb-local profile already contains a session; log out before importing"));
+    }
+    store.write(&session)
+}
+
+pub(super) async fn load_auth(home: &Path, profile: &CcLbConfig, route: &AuthRouteConfig) -> io::Result<Option<CodexAuth>> {
+    let storage = Arc::new(LocalSessionStore::new(home, profile)?);
+    let reader = Arc::clone(&storage);
+    let Some(document) = tokio::task::spawn_blocking(move || reader.load()).await
+        .map_err(|_| io::Error::other("cc-lb-local credential storage read failed"))?? else { return Ok(None); };
+    let state = ChatgptAuthState {
+        auth_dot_json: Arc::new(Mutex::new(Some(document))),
+        client: crate::default_client::create_default_auth_client(&format!("{}/oauth/token", storage.profile.origin), route).map_err(io::Error::other)?,
+    };
+    Ok(Some(CodexAuth::Chatgpt(ChatgptAuth { state, storage })))
+}
+
+async fn read_response<T: serde::de::DeserializeOwned>(mut response: codex_http_client::HttpResponse) -> io::Result<T> {
+    let mut bytes = Vec::new();
+    while let Some(chunk) = response.chunk().await.map_err(|_| invalid_session())? {
+        if bytes.len().saturating_add(chunk.len()) > MAX_SESSION_BYTES as usize { return Err(invalid_session()); }
+        bytes.extend_from_slice(&chunk);
+    }
+    serde_json::from_slice(&bytes).map_err(|_| invalid_session())
+}
