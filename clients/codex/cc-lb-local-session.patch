+fn cache_control_no_store_is_a_directive_not_quoted_extension_text() {
+    for value in ["no-store", "private, No-Store, max-age=0", r#"extension="a,b", no-store"#] {
+        assert!(has_no_store_directive(value));
+    }
+    for value in [r#"extension="a,no-store,b""#, "no-store=false", "private", r#"extension="no-store"#] {
+        assert!(!has_no_store_directive(value));
+    }
+    let mut headers = http::HeaderMap::new();
+    headers.append(http::header::CACHE_CONTROL, http::HeaderValue::from_static("private"));
+    headers.append(http::header::CACHE_CONTROL, http::HeaderValue::from_static("no-store, max-age=0"));
+    assert!(response_is_no_store(&headers));
+}
