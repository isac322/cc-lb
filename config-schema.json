{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "type": "object",
  "properties": {
    "admin": {
      "$ref": "#/$defs/AdminConfig",
      "default": {
        "auth": {
          "providers": []
        }
      }
    },
    "aead": {
      "$ref": "#/$defs/AeadConfig",
      "default": {
        "key_env": "CC_LB_MASTER_KEY"
      }
    },
    "body": {
      "$ref": "#/$defs/BodyConfig",
      "default": {
        "files_cap_bytes": 104857600,
        "messages_cap_bytes": 33554432
      }
    },
    "bulkhead": {
      "$ref": "#/$defs/BulkheadConfig",
      "default": {
        "max_conns_per_upstream": 50,
        "semaphore_per_upstream": 100
      }
    },
    "circuit_breaker": {
      "$ref": "#/$defs/CircuitBreakerConfig",
      "default": {
        "failures_to_open": 5,
        "half_open_after_secs": 30,
        "window_secs": 10
      }
    },
    "event_bus": {
      "$ref": "#/$defs/EventBusConfig",
      "default": {
        "broadcast_capacity": 4096,
        "pg_notify_channel": "cc_lb_events_partial",
        "storage_tail_poll_interval_ms": 250
      }
    },
    "limit_reservation_ttl": {
      "$ref": "#/$defs/LimitReservationTtlConfig",
      "default": {
        "tick_secs": 30,
        "ttl_secs": 300
      }
    },
    "listener": {
      "$ref": "#/$defs/ListenerConfig",
      "default": {
        "admin_addr": "[::1]:9090",
        "metrics_addr": "[::1]:9091",
        "proxy_addr": "[::]:8080"
      }
    },
    "oauth": {
      "$ref": "#/$defs/OAuthConfig",
      "default": {}
    },
    "observability": {
      "$ref": "#/$defs/ObservabilityConfig",
      "default": {
        "log_redaction": true,
        "request_diagnostics_log": false,
        "tracing_level": "info",
        "user_prompt_redaction": false
      }
    },
    "openai_oauth_compat": {
      "description": "Restart-only defaults for public `/v1` requests served by\nChatGPT-subscription (`openai_oauth`) upstreams. Each principal may\noverride individual fields through the admin API.",
      "$ref": "#/$defs/OpenaiOauthCompatPolicy",
      "default": {
        "background": "drop",
        "chat_n": "emulate",
        "chat_seed_penalties": "drop",
        "chat_stop": "emulate",
        "compact": "emulate",
        "hosted_tools": "drop_tool",
        "logprobs": "drop",
        "max_tool_calls": "drop",
        "metadata": "drop_echo",
        "prompt_cache_in_memory": "drop",
        "sampling": "drop",
        "service_tier": "coerce",
        "store_true": "coerce",
        "transcription": "disabled",
        "truncation_auto": "emulate",
        "web_search_preview": "coerce"
      }
    },
    "openai_public_api": {
      "$ref": "#/$defs/OpenaiPublicApiConfig",
      "default": {
        "realtime_origin": "https://api.openai.com/"
      }
    },
    "price_catalog": {
      "$ref": "#/$defs/PriceCatalogConfig",
      "default": {
        "cache_path": "/var/lib/cc-lb/litellm.json",
        "url": "https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json"
      }
    },
    "prompt_cache_shadow": {
      "$ref": "#/$defs/PromptCacheShadowConfig",
      "default": {
        "grace_margin_secs": 0
      }
    },
    "request_event_retention_days": {
      "type": "integer",
      "format": "uint64",
      "default": 90,
      "minimum": 0
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeConfig",
      "default": {
        "wasmtime": {
          "allocation_strategy": "ondemand",
          "cookie_redaction": false,
          "shape_origin_policy": "selected_upstream_origin",
          "wire_bounds": {
            "max_header_value_bytes": 8192,
            "max_headers": 100,
            "output_body_bytes": 104857600,
            "reason_bytes": 256
          }
        }
      }
    },
    "scheduler": {
      "$ref": "#/$defs/SchedulerConfig",
      "default": {
        "dlq_retention_days": 30,
        "entity_concurrency": 8,
        "keepalive_concurrency": 4,
        "keepalive_dispatch_timeout_secs": 30,
        "recurring_jobs": {
          "anthropic_compat_refresh": {
            "enabled": true,
            "interval_secs": 86400,
            "jitter_secs": 30
          },
          "apalis_housekeeping": {
            "enabled": true,
            "interval_secs": 3600,
            "jitter_secs": 30
          },
          "api_key_usage_poll": {
            "enabled": true,
            "interval_secs": 300,
            "jitter_secs": 15
          },
          "oauth_refresh_watchdog": {
            "enabled": true,
            "interval_secs": 9360,
            "jitter_secs": 30
          },
          "oauth_usage_poll": {
            "enabled": true,
            "interval_secs": 60,
            "jitter_secs": 15
          },
          "pool_quota_snapshot": {
            "enabled": true,
            "interval_secs": 60,
            "jitter_secs": 29
          },
          "price_catalog_refresh": {
            "enabled": true,
            "interval_secs": 3600,
            "jitter_secs": 30
          },
          "prompt_cache_purge": {
            "enabled": true,
            "interval_secs": 600,
            "jitter_secs": 30
          },
          "upstream_affinity_purge": {
            "enabled": true,
            "interval_secs": 600,
            "jitter_secs": 30
          },
          "usage_prune": {
            "enabled": true,
            "interval_secs": 86400,
            "jitter_secs": 30
          },
          "usage_rollup": {
            "enabled": true,
            "interval_secs": 30,
            "jitter_secs": 3
          },
          "warmup_watchdog": {
            "enabled": true,
            "interval_secs": 6000,
            "jitter_secs": 30
          }
        },
        "separate_pool": {
          "acquire_timeout_secs": 5,
          "idle_timeout_secs": 600,
          "max_connections": 5,
          "min_connections": 1,
          "statement_timeout_secs": 30
        },
        "singleton_concurrency": 2
      }
    },
    "storage": {
      "$ref": "#/$defs/StorageConfig",
      "default": {
        "kind": "sqlite",
        "path": "/var/lib/cc-lb/storage.sqlite"
      }
    },
    "subscription_quota": {
      "$ref": "#/$defs/SubscriptionQuotaConfig",
      "default": {
        "routing_max_staleness_secs": 1800,
        "writer_batch_max_records": 256,
        "writer_channel_capacity": 4096,
        "writer_flush_ms": 100
      }
    },
    "timeouts": {
      "$ref": "#/$defs/TimeoutsConfig",
      "default": {
        "drain_secs": 60,
        "upstream_total_secs": 600
      }
    },
    "upstream_affinity": {
      "$ref": "#/$defs/UpstreamAffinityConfig",
      "default": {
        "ttl_days": 7,
        "unknown_openai_reasoning": "hybrid"
      }
    },
    "warmup": {
      "$ref": "#/$defs/WarmupConfig",
      "default": {
        "gemini_antigravity_model": "gemini-3.8-flash-low",
        "gemini_model": "gemini-2.5-flash-lite",
        "gemini_third_party_model": "gpt-oss-120b-medium",
        "openai_model": "gpt-6.1-sol"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "AdminAuthConfig": {
      "type": "object",
      "properties": {
        "providers": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/AdminAuthProviderConfig"
          }
        }
      }
    },
    "AdminAuthProviderConfig": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "static_token"
            },
            "token_env": {
              "type": "string",
              "default": "CC_LB_ADMIN_TOKEN"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "audiences": {
              "description": "Access application audience tags accepted for the admin surface.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "header": {
              "type": "string",
              "default": "cf-access-jwt-assertion"
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "cloudflare_access"
            },
            "team_domain": {
              "description": "Access team domain, used as the issuer and JWKS base URL.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id",
            "team_domain",
            "audiences"
          ]
        }
      ]
    },
    "AdminConfig": {
      "type": "object",
      "properties": {
        "auth": {
          "$ref": "#/$defs/AdminAuthConfig",
          "default": {
            "providers": []
          }
        }
      },
      "additionalProperties": false
    },
    "AeadConfig": {
      "type": "object",
      "properties": {
        "key_env": {
          "type": "string",
          "default": "CC_LB_MASTER_KEY"
        }
      },
      "additionalProperties": false
    },
    "AnthropicOAuthConfig": {
      "type": "object",
      "properties": {
        "auth_url": {
          "type": "string",
          "format": "uri",
          "default": "https://claude.ai/oauth/authorize"
        },
        "client_id": {
          "type": "string",
          "default": "9d1c250a-e61b-44d9-88ed-5944d1962f5e"
        },
        "redirect_uri": {
          "type": "string",
          "format": "uri",
          "default": "https://console.anthropic.com/oauth/code/callback"
        },
        "scopes": {
          "description": "Scopes requested on every Anthropic OAuth authorization.\n\nConnecting always asks Anthropic for a 365-day access token, which it\nonly grants for inference-only scopes: `org:create_api_key`,\n`user:sessions:claude_code`, and `user:mcp_servers` would each force a\nshorter lifetime, and cc-lb uses none of them. If Anthropic still\nrefuses or shortens the grant, the connect flow keeps the credential\nrefreshable instead.",
          "type": "array",
          "default": [
            "user:profile",
            "user:inference"
          ],
          "items": {
            "type": "string"
          }
        },
        "token_url": {
          "type": "string",
          "format": "uri",
          "default": "https://console.anthropic.com/v1/oauth/token"
        }
      }
    },
    "AntigravityOAuthConfig": {
      "type": "object",
      "properties": {
        "authorize_url": {
          "type": "string",
          "format": "uri",
          "default": "https://accounts.google.com/o/oauth2/v2/auth"
        },
        "client_id": {
          "type": "string",
          "default": ""
        },
        "client_secret": {
          "type": "string",
          "default": ""
        },
        "code_assist_url": {
          "type": "string",
          "format": "uri",
          "default": "https://daily-cloudcode-pa.googleapis.com/"
        },
        "redirect_uri": {
          "type": "string",
          "format": "uri",
          "default": "http://localhost:51121/oauth-callback"
        },
        "scopes": {
          "type": "array",
          "default": [
            "https://www.googleapis.com/auth/cloud-platform",
            "https://www.googleapis.com/auth/userinfo.email",
            "https://www.googleapis.com/auth/userinfo.profile",
            "https://www.googleapis.com/auth/cclog",
            "https://www.googleapis.com/auth/experimentsandconfigs"
          ],
          "items": {
            "type": "string"
          }
        },
        "token_url": {
          "type": "string",
          "format": "uri",
          "default": "https://oauth2.googleapis.com/token"
        },
        "user_agent": {
          "type": "string",
          "default": "antigravity/hub/2.24.0 (aidev_client; os_type=darwin; arch=arm64; cl=1000335682)"
        },
        "userinfo_url": {
          "type": "string",
          "format": "uri",
          "default": "https://www.googleapis.com/oauth2/v2/userinfo?alt=json"
        }
      }
    },
    "BodyConfig": {
      "type": "object",
      "properties": {
        "files_cap_bytes": {
          "type": "integer",
          "format": "uint64",
          "default": 104857600,
          "minimum": 0
        },
        "messages_cap_bytes": {
          "type": "integer",
          "format": "uint64",
          "default": 33554432,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "BulkheadConfig": {
      "type": "object",
      "properties": {
        "max_conns_per_upstream": {
          "type": "integer",
          "format": "uint32",
          "default": 50,
          "minimum": 0
        },
        "semaphore_per_upstream": {
          "type": "integer",
          "format": "uint32",
          "default": 100,
          "minimum": 0
        }
      }
    },
    "CircuitBreakerConfig": {
      "type": "object",
      "properties": {
        "failures_to_open": {
          "type": "integer",
          "format": "uint32",
          "default": 5,
          "minimum": 0
        },
        "half_open_after_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 30,
          "minimum": 0
        },
        "window_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 10,
          "minimum": 0
        }
      }
    },
    "CoerceOrReject": {
      "description": "A value the backend does not accept: send the nearest supported value, or\nreject the request.",
      "oneOf": [
        {
          "description": "Replace the value with the nearest supported one.",
          "type": "string",
          "const": "coerce"
        },
        {
          "description": "Answer 400 `invalid_request_error` naming the parameter.",
          "type": "string",
          "const": "reject"
        }
      ]
    },
    "DropOrReject": {
      "description": "A parameter the backend does not accept: drop it, or reject the request.",
      "oneOf": [
        {
          "description": "Remove the parameter and serve the request.",
          "type": "string",
          "const": "drop"
        },
        {
          "description": "Answer 400 `invalid_request_error` naming the parameter.",
          "type": "string",
          "const": "reject"
        }
      ]
    },
    "EmulateDropOrReject": {
      "description": "A feature cc-lb can emulate, ignore, or reject.",
      "oneOf": [
        {
          "description": "Emulate the feature.",
          "type": "string",
          "const": "emulate"
        },
        {
          "description": "Remove the parameter and serve the request without the feature.",
          "type": "string",
          "const": "drop"
        },
        {
          "description": "Answer 400 `invalid_request_error` naming the parameter.",
          "type": "string",
          "const": "reject"
        }
      ]
    },
    "EmulateOrReject": {
      "description": "A feature cc-lb can emulate on top of the backend, or reject.",
      "oneOf": [
        {
          "description": "Emulate the feature.",
          "type": "string",
          "const": "emulate"
        },
        {
          "description": "Answer 400 `invalid_request_error` naming the parameter.",
          "type": "string",
          "const": "reject"
        }
      ]
    },
    "EnabledOrDisabled": {
      "description": "Whether an optional subscription-backed operation is served.",
      "oneOf": [
        {
          "description": "The operation is not served by subscription upstreams.",
          "type": "string",
          "const": "disabled"
        },
        {
          "description": "The operation is served by subscription upstreams.",
          "type": "string",
          "const": "enabled"
        }
      ]
    },
    "EventBusConfig": {
      "type": "object",
      "properties": {
        "broadcast_capacity": {
          "type": "integer",
          "format": "uint",
          "default": 4096,
          "minimum": 0
        },
        "pg_notify_channel": {
          "type": "string",
          "default": "cc_lb_events_partial"
        },
        "storage_tail_poll_interval_ms": {
          "type": "integer",
          "format": "uint64",
          "default": 250,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "GeminiOAuthConfig": {
      "type": "object",
      "properties": {
        "code_assist_url": {
          "type": "string",
          "format": "uri",
          "default": "https://cloudcode-pa.googleapis.com/v1internal"
        },
        "userinfo_url": {
          "type": "string",
          "format": "uri",
          "default": "https://www.googleapis.com/oauth2/v3/userinfo"
        }
      }
    },
    "HostedToolHandling": {
      "description": "Handling of hosted tools that only an API-key account can run\n(`file_search`, `code_interpreter`) when no `openai_api_key` upstream can\nserve the request.",
      "oneOf": [
        {
          "description": "Remove the tool, and release a `tool_choice` that forces it.",
          "type": "string",
          "const": "drop_tool"
        },
        {
          "description": "Answer 400 `invalid_request_error` naming the tool.",
          "type": "string",
          "const": "reject"
        }
      ]
    },
    "LimitReservationTtlConfig": {
      "description": "Background TTL sweeper for stale limit reservations. The LimitEngine\nperiodically walks its reservation map and full-refunds any reservation\nolder than `ttl_secs`; the sweeper runs unconditionally because the\nsubscriber path is authoritative.",
      "type": "object",
      "properties": {
        "tick_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 30,
          "minimum": 0
        },
        "ttl_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 300,
          "minimum": 0
        }
      }
    },
    "ListenerConfig": {
      "type": "object",
      "properties": {
        "admin_addr": {
          "type": "string",
          "default": "[::1]:9090"
        },
        "metrics_addr": {
          "type": "string",
          "default": "[::1]:9091"
        },
        "proxy_addr": {
          "type": "string",
          "default": "[::]:8080"
        },
        "tls": {
          "anyOf": [
            {
              "$ref": "#/$defs/TlsConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "MetadataHandling": {
      "description": "Handling of request `metadata`.",
      "oneOf": [
        {
          "description": "Remove it upstream and copy the client's value into the response object.",
          "type": "string",
          "const": "drop_echo"
        },
        {
          "description": "Remove it upstream; the response carries no client metadata.",
          "type": "string",
          "const": "drop"
        },
        {
          "description": "Answer 400 `invalid_request_error` naming the parameter.",
          "type": "string",
          "const": "reject"
        }
      ]
    },
    "OAuthConfig": {
      "type": "object",
      "properties": {
        "anthropic": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnthropicOAuthConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "antigravity": {
          "anyOf": [
            {
              "$ref": "#/$defs/AntigravityOAuthConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "gemini": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeminiOAuthConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "openai": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpenAiOAuthConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ObservabilityConfig": {
      "type": "object",
      "properties": {
        "log_redaction": {
          "type": "boolean",
          "default": true
        },
        "otlp_endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "request_diagnostics_log": {
          "type": "boolean",
          "default": false
        },
        "tracing_level": {
          "type": "string",
          "default": "info"
        },
        "user_prompt_redaction": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "OpenAiOAuthConfig": {
      "type": "object",
      "properties": {
        "authorize_url": {
          "type": "string",
          "format": "uri",
          "default": "https://auth.openai.com/oauth/authorize"
        },
        "browser_redirect_uri": {
          "type": "string",
          "format": "uri",
          "default": "http://localhost:1455/auth/callback"
        },
        "client_id": {
          "type": "string",
          "default": "app_EMoamEEZ73f0CkXaXp7hrann"
        },
        "device_redirect_uri": {
          "type": "string",
          "format": "uri",
          "default": "https://auth.openai.com/deviceauth/callback"
        },
        "device_token_url": {
          "type": "string",
          "format": "uri",
          "default": "https://auth.openai.com/api/accounts/deviceauth/token"
        },
        "device_usercode_url": {
          "type": "string",
          "format": "uri",
          "default": "https://auth.openai.com/api/accounts/deviceauth/usercode"
        },
        "device_verification_url": {
          "type": "string",
          "format": "uri",
          "default": "https://auth.openai.com/codex/device"
        },
        "token_url": {
          "type": "string",
          "format": "uri",
          "default": "https://auth.openai.com/oauth/token"
        }
      }
    },
    "OpenaiOauthCompatPolicy": {
      "description": "Effective compatibility policy. Every field is concrete.",
      "type": "object",
      "properties": {
        "background": {
          "description": "`background: true` when no API-key upstream can serve it.",
          "$ref": "#/$defs/DropOrReject",
          "default": "drop"
        },
        "chat_n": {
          "description": "Chat Completions `n > 1`: fan out `n` requests, or reject.",
          "$ref": "#/$defs/EmulateOrReject",
          "default": "emulate"
        },
        "chat_seed_penalties": {
          "description": "Chat Completions `seed`, `frequency_penalty`, `presence_penalty`.",
          "$ref": "#/$defs/DropOrReject",
          "default": "drop"
        },
        "chat_stop": {
          "description": "Chat Completions `stop`.",
          "$ref": "#/$defs/EmulateDropOrReject",
          "default": "emulate"
        },
        "compact": {
          "description": "`POST /v1/responses/compact`.",
          "$ref": "#/$defs/EmulateOrReject",
          "default": "emulate"
        },
        "hosted_tools": {
          "description": "`file_search` / `code_interpreter` when no API-key upstream can serve it.",
          "$ref": "#/$defs/HostedToolHandling",
          "default": "drop_tool"
        },
        "logprobs": {
          "description": "`top_logprobs` and `include: [\"message.output_text.logprobs\"]`.",
          "$ref": "#/$defs/DropOrReject",
          "default": "drop"
        },
        "max_tool_calls": {
          "description": "`max_tool_calls`.",
          "$ref": "#/$defs/DropOrReject",
          "default": "drop"
        },
        "metadata": {
          "description": "`metadata`, `user`, `safety_identifier`.",
          "$ref": "#/$defs/MetadataHandling",
          "default": "drop_echo"
        },
        "prompt_cache_in_memory": {
          "description": "`prompt_cache_retention: \"in_memory\"` (the backend retains up to 24h).",
          "$ref": "#/$defs/DropOrReject",
          "default": "drop"
        },
        "sampling": {
          "description": "`temperature`, `top_p`.",
          "$ref": "#/$defs/DropOrReject",
          "default": "drop"
        },
        "service_tier": {
          "description": "`service_tier` `auto` or `flex`: coerce to `default`, or reject.",
          "$ref": "#/$defs/CoerceOrReject",
          "default": "coerce"
        },
        "store_true": {
          "description": "`store: true`: coerce to `false`, or reject.",
          "$ref": "#/$defs/CoerceOrReject",
          "default": "coerce"
        },
        "transcription": {
          "description": "`POST /v1/audio/transcriptions` through the subscription dictation\nendpoint. The upstream retains submitted audio for 30 days.",
          "$ref": "#/$defs/EnabledOrDisabled",
          "default": "disabled"
        },
        "truncation_auto": {
          "description": "`truncation: \"auto\"`: emulate by trimming the oldest items and\nretrying on `context_length_exceeded`, drop, or reject.",
          "$ref": "#/$defs/EmulateDropOrReject",
          "default": "emulate"
        },
        "web_search_preview": {
          "description": "`web_search_preview` tool: coerce to `web_search`, or reject.",
          "$ref": "#/$defs/CoerceOrReject",
          "default": "coerce"
        }
      },
      "additionalProperties": false
    },
    "OpenaiPublicApiConfig": {
      "type": "object",
      "properties": {
        "realtime_origin": {
          "type": "string",
          "format": "uri",
          "default": "https://api.openai.com/"
        }
      },
      "additionalProperties": false
    },
    "PluginWireBounds": {
      "description": "Upper bounds enforced on plugin wire I/O. Defaults match current\nunbounded-ish behaviour by tracking the request body cap already\nenforced at the HTTP layer, so enabling this struct with defaults\nis a no-op. Tightening any field is opt-in.",
      "type": "object",
      "properties": {
        "max_header_value_bytes": {
          "type": "integer",
          "format": "uint32",
          "default": 8192,
          "minimum": 0
        },
        "max_headers": {
          "type": "integer",
          "format": "uint32",
          "default": 100,
          "minimum": 0
        },
        "output_body_bytes": {
          "type": "integer",
          "format": "uint64",
          "default": 104857600,
          "minimum": 0
        },
        "reason_bytes": {
          "type": "integer",
          "format": "uint32",
          "default": 256,
          "minimum": 0
        }
      }
    },
    "PostgresPoolConfig": {
      "type": "object",
      "properties": {
        "acquire_timeout_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 5,
          "minimum": 0
        },
        "idle_timeout_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 600,
          "minimum": 0
        },
        "listener_url": {
          "description": "Optional direct PostgreSQL URL for dedicated session-pinned listeners (`LISTEN/NOTIFY`), migrations, and advisory locks when `url` goes through a transaction pooler such as PgBouncer.",
          "type": [
            "string",
            "null"
          ]
        },
        "max_connections": {
          "type": "integer",
          "format": "uint32",
          "default": 10,
          "minimum": 0
        },
        "max_lifetime_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 1800,
          "minimum": 0
        },
        "min_connections": {
          "type": "integer",
          "format": "uint32",
          "default": 1,
          "minimum": 0
        },
        "pgbouncer_transaction_pooling": {
          "description": "Configure connections for PgBouncer transaction pooling (requires PgBouncer >= 1.21 with `max_prepared_statements > 0`, defaults `statement_cache_capacity` to `100` while rejecting `0`, and skips session-level `SET` statements in `after_connect`).",
          "type": "boolean"
        },
        "sslmode": {
          "description": "Optional SSL mode override; when omitted, inherit `sslmode` or `ssl-mode` from the PostgreSQL URL.",
          "type": [
            "string",
            "null"
          ]
        },
        "statement_cache_capacity": {
          "description": "Optional SQLx prepared-statement cache capacity override (must be greater than `0` when `pgbouncer_transaction_pooling` is enabled).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "statement_timeout_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 30,
          "minimum": 0
        },
        "test_before_acquire": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "PriceCatalogConfig": {
      "type": "object",
      "properties": {
        "cache_path": {
          "type": "string",
          "default": "/var/lib/cc-lb/litellm.json"
