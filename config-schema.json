    "UnknownOpenaiReasoningPolicy": {
      "description": "Handling for OpenAI Responses requests whose only unestablished opaque\naffinity state is `reasoning.encrypted_content` (and for unmatched pending\n`reasoning.encrypted_content` on a resolved OpenAI owner).",
      "oneOf": [
        {
          "description": "Fail closed with `503 upstream_affinity_unavailable`.",
          "type": "string",
          "const": "fail_closed"
        },
        {
          "description": "Preserve unknown `reasoning.encrypted_content` verbatim when a single\neligible OpenAI upstream exists (or an owner is already resolved) and\nretry once with only the unmatched `reasoning` items removed if the\nupstream rejects with `invalid_encrypted_content`; when multiple\neligible OpenAI upstreams exist and no owner is established, strip\nunknown `reasoning` items before dispatch instead of guessing.",
          "type": "string",
          "const": "hybrid"
        }
      ]
    },
