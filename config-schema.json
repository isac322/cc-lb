            "apalis_housekeeping": {
              "enabled": true,
              "interval_secs": 3600,
              "jitter_secs": 30
            },
            "api_key_usage_poll": {
              "enabled": true,
              "interval_secs": 300,
              "jitter_secs": 15
            },
            "oauth_refresh_watchdog": {
              "enabled": true,
              "interval_secs": 9360,
              "jitter_secs": 30
            },
            "oauth_usage_poll": {
              "enabled": true,
              "interval_secs": 60,
              "jitter_secs": 15
            },
            "pool_quota_snapshot": {
              "enabled": true,
              "interval_secs": 60,
              "jitter_secs": 29
            },
            "price_catalog_refresh": {
              "enabled": true,
              "interval_secs": 3600,
              "jitter_secs": 30
            },
            "prompt_cache_purge": {
              "enabled": true,
              "interval_secs": 600,
              "jitter_secs": 30
            },
            "upstream_affinity_purge": {
              "enabled": true,
              "interval_secs": 600,
              "jitter_secs": 30
            },
            "usage_prune": {
              "enabled": true,
              "interval_secs": 86400,
              "jitter_secs": 30
            },
            "usage_rollup": {
              "enabled": true,
              "interval_secs": 30,
              "jitter_secs": 3
            },
            "warmup_watchdog": {
              "enabled": true,
              "interval_secs": 6000,
              "jitter_secs": 30
            }
          }
        },
        "separate_pool": {
          "$ref": "#/$defs/SchedulerPoolConfig",
          "default": {
            "acquire_timeout_secs": 5,
            "idle_timeout_secs": 600,
            "max_connections": 5,
            "min_connections": 1,
