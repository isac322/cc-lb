{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "type": "object",
  "properties": {
    "admin": {
      "$ref": "#/$defs/AdminConfig",
      "default": {
        "auth": {
          "providers": []
        }
      }
    },
    "aead": {
      "$ref": "#/$defs/AeadConfig",
      "default": {
        "key_env": "CC_LB_MASTER_KEY"
      }
    },
    "body": {
      "$ref": "#/$defs/BodyConfig",
      "default": {
        "files_cap_bytes": 104857600,
        "messages_cap_bytes": 33554432
      }
    },
    "bulkhead": {
      "$ref": "#/$defs/BulkheadConfig",
      "default": {
        "max_conns_per_upstream": 50,
        "semaphore_per_upstream": 100
      }
    },
    "circuit_breaker": {
      "$ref": "#/$defs/CircuitBreakerConfig",
      "default": {
        "failures_to_open": 5,
        "half_open_after_secs": 30,
        "window_secs": 10
      }
    },
    "cluster": {
      "$ref": "#/$defs/ClusterConfig",
      "default": {
        "token_env": "CC_LB_CLUSTER_TOKEN"
      }
    },
    "event_bus": {
      "$ref": "#/$defs/EventBusConfig",
      "default": {
        "broadcast_capacity": 4096,
        "partial_retention_max_entries": 10000,
        "partial_retention_ttl_secs": 300,
        "pg_notify_channel": "cc_lb_events_partial",
        "storage_tail_poll_interval_ms": 250
      }
    },
    "limit_reservation_ttl": {
      "$ref": "#/$defs/LimitReservationTtlConfig",
      "default": {
        "tick_secs": 30,
        "ttl_secs": 300
      }
    },
    "listener": {
      "$ref": "#/$defs/ListenerConfig",
      "default": {
        "admin_addr": "[::1]:9090",
        "metrics_addr": "[::1]:9091",
        "proxy_addr": "[::]:8080"
      }
    },
    "oauth": {
      "$ref": "#/$defs/OAuthConfig",
      "default": {}
    },
    "observability": {
      "$ref": "#/$defs/ObservabilityConfig",
      "default": {
        "log_redaction": true,
        "tracing_level": "info",
        "user_prompt_redaction": false
      }
    },
    "price_catalog": {
      "$ref": "#/$defs/PriceCatalogConfig",
      "default": {
        "cache_path": "/var/lib/cc-lb/litellm.json",
        "url": "https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json"
      }
    },
    "prompt_cache_shadow": {
      "$ref": "#/$defs/PromptCacheShadowConfig",
      "default": {
        "grace_margin_secs": 30
      }
    },
    "request_event_retention_days": {
      "type": "integer",
      "format": "uint64",
      "default": 90,
      "minimum": 0
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeConfig",
      "default": {
        "wasmtime": {
          "allocation_strategy": "ondemand",
          "cookie_redaction": false,
          "shape_origin_policy": "unrestricted",
          "wire_bounds": {
            "max_header_value_bytes": 8192,
            "max_headers": 100,
            "output_body_bytes": 104857600,
            "reason_bytes": 256
          }
        }
      }
    },
    "scheduler": {
      "$ref": "#/$defs/SchedulerConfig",
      "default": {
        "dlq_retention_days": 30,
        "entity_concurrency": 8,
        "keepalive_concurrency": 4,
        "recurring_jobs": {
          "anthropic_compat_refresh": {
            "enabled": true,
            "interval_secs": 86400,
            "jitter_secs": 30
          },
          "apalis_housekeeping": {
            "enabled": true,
            "interval_secs": 3600,
            "jitter_secs": 30
          },
          "oauth_refresh_watchdog": {
            "enabled": true,
            "interval_secs": 9360,
            "jitter_secs": 30
          },
          "oauth_usage_poll": {
            "enabled": true,
            "interval_secs": 60,
            "jitter_secs": 0
          },
          "pool_quota_snapshot": {
            "enabled": true,
            "interval_secs": 60,
            "jitter_secs": 0
          },
          "price_catalog_refresh": {
            "enabled": true,
            "interval_secs": 3600,
            "jitter_secs": 30
          },
          "prompt_cache_purge": {
            "enabled": true,
            "interval_secs": 600,
            "jitter_secs": 30
          },
          "upstream_affinity_purge": {
            "enabled": true,
            "interval_secs": 600,
            "jitter_secs": 30
          },
          "usage_prune": {
            "enabled": true,
            "interval_secs": 86400,
            "jitter_secs": 30
          },
          "usage_rollup": {
            "enabled": true,
            "interval_secs": 30,
            "jitter_secs": 3
          },
          "warmup_watchdog": {
            "enabled": true,
            "interval_secs": 6000,
            "jitter_secs": 30
          }
        },
        "separate_pool": {
          "acquire_timeout_secs": 5,
          "idle_timeout_secs": 600,
          "max_connections": 5,
          "min_connections": 1,
          "sslmode": "prefer",
          "statement_timeout_secs": 30
        },
        "singleton_concurrency": 2
      }
    },
    "storage": {
      "$ref": "#/$defs/StorageConfig",
      "default": {
        "kind": "sqlite",
        "path": "/var/lib/cc-lb/storage.sqlite"
      }
    },
    "subscription_quota": {
      "$ref": "#/$defs/SubscriptionQuotaConfig",
      "default": {
        "routing_max_staleness_secs": 1800,
        "writer_batch_max_records": 256,
        "writer_channel_capacity": 4096,
        "writer_flush_ms": 100
      }
    },
    "timeouts": {
      "$ref": "#/$defs/TimeoutsConfig",
      "default": {
        "drain_secs": 60,
        "upstream_total_secs": 600
      }
    },
    "upstream_affinity": {
      "$ref": "#/$defs/UpstreamAffinityConfig",
      "default": {
        "ttl_days": 90
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "AdminAuthConfig": {
      "type": "object",
      "properties": {
        "providers": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/AdminAuthProviderConfig"
          }
        }
      }
    },
    "AdminAuthProviderConfig": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "static_token"
            },
            "token_env": {
              "type": "string",
              "default": "CC_LB_ADMIN_TOKEN"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "audiences": {
              "description": "Access application audience tags accepted for the admin surface.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "header": {
              "type": "string",
              "default": "cf-access-jwt-assertion"
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "cloudflare_access"
            },
            "team_domain": {
              "description": "Access team domain, used as the issuer and JWKS base URL.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id",
            "team_domain",
            "audiences"
          ]
        }
      ]
    },
    "AdminConfig": {
      "type": "object",
      "properties": {
        "auth": {
          "$ref": "#/$defs/AdminAuthConfig",
          "default": {
            "providers": []
          }
        }
      },
      "additionalProperties": false
    },
    "AeadConfig": {
      "type": "object",
      "properties": {
        "key_env": {
          "type": "string",
          "default": "CC_LB_MASTER_KEY"
        }
      },
      "additionalProperties": false
    },
    "AnthropicOAuthConfig": {
      "type": "object",
      "properties": {
        "auth_url": {
          "type": "string",
          "format": "uri",
          "default": "https://claude.ai/oauth/authorize"
        },
        "client_id": {
          "type": "string",
          "default": "9d1c250a-e61b-44d9-88ed-5944d1962f5e"
        },
        "redirect_uri": {
          "type": "string",
          "format": "uri",
          "default": "https://console.anthropic.com/oauth/code/callback"
        },
        "scopes": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "token_url": {
          "type": "string",
          "format": "uri",
          "default": "https://console.anthropic.com/v1/oauth/token"
        }
      }
    },
    "BodyConfig": {
      "type": "object",
      "properties": {
        "files_cap_bytes": {
          "type": "integer",
          "format": "uint64",
          "default": 104857600,
          "minimum": 0
        },
        "messages_cap_bytes": {
          "type": "integer",
          "format": "uint64",
          "default": 33554432,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "BulkheadConfig": {
      "type": "object",
      "properties": {
        "max_conns_per_upstream": {
          "type": "integer",
          "format": "uint32",
          "default": 50,
          "minimum": 0
        },
        "semaphore_per_upstream": {
          "type": "integer",
          "format": "uint32",
          "default": 100,
          "minimum": 0
        }
      }
    },
    "CircuitBreakerConfig": {
      "type": "object",
      "properties": {
        "failures_to_open": {
          "type": "integer",
          "format": "uint32",
          "default": 5,
          "minimum": 0
        },
        "half_open_after_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 30,
          "minimum": 0
        },
        "window_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 10,
          "minimum": 0
        }
      }
    },
    "ClusterConfig": {
      "type": "object",
      "properties": {
        "instance_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "token_env": {
          "type": "string",
          "default": "CC_LB_CLUSTER_TOKEN"
        }
      },
      "additionalProperties": false
    },
    "EventBusConfig": {
      "type": "object",
      "properties": {
        "broadcast_capacity": {
          "type": "integer",
          "format": "uint",
          "default": 4096,
          "minimum": 0
        },
        "partial_retention_max_entries": {
          "type": "integer",
          "format": "uint",
          "default": 10000,
          "minimum": 0
        },
        "partial_retention_ttl_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 300,
          "minimum": 0
        },
        "pg_notify_channel": {
          "type": "string",
          "default": "cc_lb_events_partial"
        },
        "storage_tail_poll_interval_ms": {
          "type": "integer",
          "format": "uint64",
          "default": 250,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "LimitReservationTtlConfig": {
      "description": "Background TTL sweeper for stale limit reservations. The LimitEngine\nperiodically walks its reservation map and full-refunds any reservation\nolder than `ttl_secs`; the sweeper runs unconditionally because the\nsubscriber path is authoritative.",
      "type": "object",
      "properties": {
        "tick_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 30,
          "minimum": 0
        },
        "ttl_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 300,
          "minimum": 0
        }
      }
    },
    "ListenerConfig": {
      "type": "object",
      "properties": {
        "admin_addr": {
          "type": "string",
          "default": "[::1]:9090"
        },
        "metrics_addr": {
          "type": "string",
          "default": "[::1]:9091"
        },
        "proxy_addr": {
          "type": "string",
          "default": "[::]:8080"
        },
        "tls": {
          "anyOf": [
            {
              "$ref": "#/$defs/TlsConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "OAuthConfig": {
      "type": "object",
      "properties": {
        "anthropic": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnthropicOAuthConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ObservabilityConfig": {
      "type": "object",
      "properties": {
        "log_redaction": {
          "type": "boolean",
          "default": true
        },
        "otlp_endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "tracing_level": {
          "type": "string",
          "default": "info"
        },
        "user_prompt_redaction": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "PluginWireBounds": {
      "description": "Upper bounds enforced on plugin wire I/O. Defaults match current\nunbounded-ish behaviour by tracking the request body cap already\nenforced at the HTTP layer, so enabling this struct with defaults\nis a no-op. Tightening any field is opt-in.",
      "type": "object",
      "properties": {
        "max_header_value_bytes": {
          "type": "integer",
          "format": "uint32",
          "default": 8192,
          "minimum": 0
        },
        "max_headers": {
          "type": "integer",
          "format": "uint32",
          "default": 100,
          "minimum": 0
        },
        "output_body_bytes": {
          "type": "integer",
          "format": "uint64",
          "default": 104857600,
          "minimum": 0
        },
        "reason_bytes": {
          "type": "integer",
          "format": "uint32",
          "default": 256,
          "minimum": 0
        }
      }
    },
    "PostgresPoolConfig": {
      "type": "object",
      "properties": {
        "acquire_timeout_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 5,
          "minimum": 0
        },
        "idle_timeout_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 600,
          "minimum": 0
        },
        "max_connections": {
          "type": "integer",
          "format": "uint32",
          "default": 10,
          "minimum": 0
        },
        "max_lifetime_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 1800,
          "minimum": 0
        },
        "min_connections": {
          "type": "integer",
          "format": "uint32",
          "default": 1,
          "minimum": 0
        },
        "sslmode": {
          "type": "string",
          "default": "prefer"
        },
        "statement_timeout_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 30,
          "minimum": 0
        },
        "test_before_acquire": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "PriceCatalogConfig": {
      "type": "object",
      "properties": {
        "cache_path": {
          "type": "string",
          "default": "/var/lib/cc-lb/litellm.json"
        },
        "url": {
          "type": "string",
          "default": "https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json"
        }
      },
      "additionalProperties": false
    },
    "PromptCacheShadowConfig": {
      "description": "Always-on prompt cache routing configuration.\n\nControls prompt cache observation behavior. Observations decoded from successful\nresponses are persisted to the shared observation store, and `build_candidates`\nreads that store per `(upstream, canonical model)` partition to compute cache\nscores.\n\nConfiguration keys and defaults:\n- `grace_margin_secs` (default: 30) - margin subtracted from the observed TTL when\n  an observation's expiry is recorded, expiring entries slightly early to absorb\n  provider-side TTL jitter",
      "type": "object",
      "properties": {
        "grace_margin_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 30,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "RecurringJobConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "interval_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 3600,
          "minimum": 0
        },
        "jitter_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 30,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "RuntimeConfig": {
      "type": "object",
      "properties": {
        "data_dir": {
          "type": [
            "string",
            "null"
          ]
        },
        "wasmtime": {
          "$ref": "#/$defs/WasmtimeConfig",
          "default": {
            "allocation_strategy": "ondemand",
            "cookie_redaction": false,
            "shape_origin_policy": "unrestricted",
            "wire_bounds": {
              "max_header_value_bytes": 8192,
              "max_headers": 100,
              "output_body_bytes": 104857600,
              "reason_bytes": 256
            }
          }
        }
      }
    },
    "SchedulerConfig": {
      "type": "object",
      "properties": {
        "dlq_retention_days": {
          "type": "integer",
          "format": "uint32",
          "default": 30,
          "minimum": 0
        },
        "entity_concurrency": {
          "type": "integer",
          "format": "uint",
          "default": 8,
          "minimum": 0
        },
        "keepalive_concurrency": {
          "type": "integer",
          "format": "uint",
          "default": 4,
          "minimum": 0
        },
        "recurring_jobs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/RecurringJobConfig"
          },
          "default": {
            "anthropic_compat_refresh": {
              "enabled": true,
              "interval_secs": 86400,
              "jitter_secs": 30
            },
            "apalis_housekeeping": {
              "enabled": true,
              "interval_secs": 3600,
              "jitter_secs": 30
            },
            "oauth_refresh_watchdog": {
              "enabled": true,
              "interval_secs": 9360,
              "jitter_secs": 30
            },
            "oauth_usage_poll": {
              "enabled": true,
              "interval_secs": 60,
              "jitter_secs": 0
            },
            "pool_quota_snapshot": {
              "enabled": true,
              "interval_secs": 60,
              "jitter_secs": 0
            },
            "price_catalog_refresh": {
              "enabled": true,
              "interval_secs": 3600,
              "jitter_secs": 30
            },
            "prompt_cache_purge": {
              "enabled": true,
              "interval_secs": 600,
              "jitter_secs": 30
            },
            "upstream_affinity_purge": {
              "enabled": true,
              "interval_secs": 600,
              "jitter_secs": 30
            },
            "usage_prune": {
              "enabled": true,
              "interval_secs": 86400,
              "jitter_secs": 30
            },
            "usage_rollup": {
              "enabled": true,
              "interval_secs": 30,
              "jitter_secs": 3
            },
            "warmup_watchdog": {
              "enabled": true,
              "interval_secs": 6000,
              "jitter_secs": 30
            }
          }
        },
        "separate_pool": {
          "$ref": "#/$defs/SchedulerPoolConfig",
          "default": {
            "acquire_timeout_secs": 5,
            "idle_timeout_secs": 600,
            "max_connections": 5,
            "min_connections": 1,
            "sslmode": "prefer",
            "statement_timeout_secs": 30
          }
        },
        "singleton_concurrency": {
          "type": "integer",
          "format": "uint",
          "default": 2,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "SchedulerPoolConfig": {
      "type": "object",
      "properties": {
        "acquire_timeout_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 5,
          "minimum": 0
        },
        "idle_timeout_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 600,
          "minimum": 0
        },
        "max_connections": {
          "type": "integer",
          "format": "uint32",
          "default": 5,
          "minimum": 0
        },
        "min_connections": {
          "type": "integer",
          "format": "uint32",
          "default": 1,
          "minimum": 0
        },
        "sslmode": {
          "type": "string",
          "default": "prefer"
        },
        "statement_timeout_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 30,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "ShapeOriginPolicy": {
      "description": "Whether a shape plugin may return a URL whose origin\n(scheme+host+port) differs from the selected upstream. Historical\nbehaviour is `Unrestricted`; deployments where a compromised or\nbuggy shape plugin misrouting to a wrong host is a concern can\nopt into `SelectedUpstreamOrigin` to reject any URL that does not\nmatch the selected upstream's `base_url` origin.",
      "type": "string",
      "enum": [
        "unrestricted",
        "selected_upstream_origin"
      ]
    },
    "StorageConfig": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "postgres"
            },
            "pool": {
              "$ref": "#/$defs/PostgresPoolConfig",
              "default": {
                "acquire_timeout_secs": 5,
                "idle_timeout_secs": 600,
                "max_connections": 10,
                "max_lifetime_secs": 1800,
                "min_connections": 1,
                "sslmode": "prefer",
                "statement_timeout_secs": 30,
                "test_before_acquire": true
              }
            },
            "url": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "sqlite"
            },
            "path": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ]
        }
      ]
    },
    "SubscriptionQuotaConfig": {
      "type": "object",
      "properties": {
        "routing_max_staleness_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 1800,
          "minimum": 0
        },
        "writer_batch_max_records": {
          "type": "integer",
          "format": "uint32",
          "default": 256,
          "minimum": 0
        },
        "writer_channel_capacity": {
          "type": "integer",
          "format": "uint32",
          "default": 4096,
          "minimum": 0
        },
        "writer_flush_ms": {
          "type": "integer",
          "format": "uint64",
          "default": 100,
          "minimum": 0
        }
      }
    },
    "TimeoutsConfig": {
      "type": "object",
      "properties": {
