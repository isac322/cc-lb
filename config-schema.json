    "PromptCacheShadowConfig": {
      "description": "Always-on prompt cache routing configuration.\n\nControls prompt cache observation behavior. Observations decoded from successful\nresponses are persisted to the shared observation store, and `build_candidates`\nreads that store per `(upstream, canonical model)` partition to compute cache\nscores.\n\nConfiguration keys and defaults:\n- `grace_margin_secs` (default: 0) - optional shortening of the\n  dispatch-anchored provider TTL; zero preserves the full TTL.",
      "type": "object",
      "properties": {
        "grace_margin_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 0,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
