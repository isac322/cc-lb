{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "type": "object",
  "properties": {
    "admin": {
      "$ref": "#/$defs/AdminConfig",
      "default": {
        "token_env": "CC_LB_ADMIN_TOKEN"
      }
    },
    "aead": {
      "$ref": "#/$defs/AeadConfig",
      "default": {
        "key_env": "CC_LB_MASTER_KEY"
      }
    },
    "api_keys": {
      "$ref": "#/$defs/ApiKeysConfig",
      "default": {
        "price_catalog": {
          "cache_path": "/var/lib/cc-lb/litellm.json",
          "refresh_interval": "1h",
          "url": "https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json"
        },
        "usage_retention_days": 90
      }
    },
    "body": {
      "$ref": "#/$defs/BodyConfig",
      "default": {
        "files_cap_bytes": 104857600,
        "messages_cap_bytes": 33554432,
        "per_route_overrides": {}
      }
    },
    "bulkhead": {
      "$ref": "#/$defs/BulkheadConfig",
      "default": {
        "max_conns_per_upstream": 50,
        "semaphore_per_upstream": 100
      }
    },
    "circuit_breaker": {
      "$ref": "#/$defs/CircuitBreakerConfig",
      "default": {
        "failures_to_open": 5,
        "half_open_after_secs": 30,
        "window_secs": 10
      }
    },
    "dns": {
      "$ref": "#/$defs/DnsConfig",
      "default": {
        "cache_ttl_ceiling_secs": 300,
        "cache_ttl_floor_secs": 30
      }
    },
    "downstream_auth": {
      "$ref": "#/$defs/DownstreamAuthConfig",
      "default": {
        "mode": "api_key"
      }
    },
    "egress": {
      "$ref": "#/$defs/EgressConfig",
      "default": {}
    },
    "lifecycle_api_key_metrics_subscriber": {
      "$ref": "#/$defs/LifecycleApiKeyMetricsSubscriberConfig",
      "default": {
        "enabled": true
      }
    },
    "lifecycle_cache_hit_miss_subscriber": {
      "$ref": "#/$defs/LifecycleCacheHitMissSubscriberConfig",
      "default": {
        "enabled": true
      }
    },
    "lifecycle_cache_observation_subscriber": {
      "$ref": "#/$defs/LifecycleCacheObservationSubscriberConfig",
      "default": {
        "enabled": false
      }
    },
    "lifecycle_hook_adapter": {
      "$ref": "#/$defs/LifecycleHookAdapterConfig",
      "default": {
        "enabled": false
      }
    },
    "lifecycle_limit_reconcile_subscriber": {
      "$ref": "#/$defs/LifecycleLimitReconcileSubscriberConfig",
      "default": {
        "enabled": true,
        "shadow": false
      }
    },
    "lifecycle_limit_rejection_audit_subscriber": {
      "$ref": "#/$defs/LifecycleLimitRejectionAuditSubscriberConfig",
      "default": {
        "enabled": true
      }
    },
    "lifecycle_pricing_subscriber": {
      "$ref": "#/$defs/LifecyclePricingSubscriberConfig",
      "default": {
        "enabled": false
      }
    },
    "lifecycle_prompt_cache_drift_subscriber": {
      "$ref": "#/$defs/LifecyclePromptCacheDriftSubscriberConfig",
      "default": {
        "enabled": false
      }
    },
    "lifecycle_rate_limit_header_subscriber": {
      "$ref": "#/$defs/LifecycleRateLimitHeaderSubscriberConfig",
      "default": {
        "enabled": true
      }
    },
    "lifecycle_shadow_writer": {
      "$ref": "#/$defs/LifecycleShadowWriterConfig",
      "default": {
        "enabled": false
      }
    },
    "lifecycle_subscription_quota_subscriber": {
      "$ref": "#/$defs/LifecycleSubscriptionQuotaSubscriberConfig",
      "default": {
        "enabled": true
      }
    },
    "limit_reservation_ttl": {
      "$ref": "#/$defs/LimitReservationTtlConfig",
      "default": {
        "enabled": false,
        "tick_secs": 30,
        "ttl_secs": 300
      }
    },
    "listener": {
      "$ref": "#/$defs/ListenerConfig",
      "default": {
        "admin_addr": "[::1]:9090",
        "metrics_addr": "[::1]:9091",
        "proxy_addr": "[::]:8080"
      }
    },
    "oauth": {
      "$ref": "#/$defs/OAuthConfig",
      "default": {}
    },
    "observability": {
      "$ref": "#/$defs/ObservabilityConfig",
      "default": {
        "log_redaction": true,
        "tracing_level": "info",
        "user_prompt_redaction": false
      }
    },
    "prompt_cache_shadow": {
      "$ref": "#/$defs/PromptCacheShadowConfig",
      "default": {
        "enabled": false,
        "grace_margin_secs": 30,
        "refresh_debounce_secs": 60,
        "warm_set_cap": 32
      }
    },
    "request_event_writer_source": {
      "$ref": "#/$defs/RequestEventWriterSource",
      "default": "legacy"
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeConfig",
      "default": {
        "startup_handshake": {
          "force": false,
          "skip_if_fresh": true
        },
        "wasmtime": {
          "cookie_redaction": false,
          "plugin_failure_policy": "pass_through",
          "shape_origin_policy": "unrestricted",
          "wire_bounds": {
            "max_header_value_bytes": 8192,
            "max_headers": 100,
            "normalize_error_body_bytes": 262144,
            "output_body_bytes": 104857600,
            "reason_bytes": 256
          }
        }
      }
    },
    "scheduler": {
      "$ref": "#/$defs/SchedulerConfig",
      "default": {
        "dlq_retention_days": 30,
        "entity_concurrency": 8,
        "idempotency": {
          "claim_ttl_secs": 60
        },
        "pgbouncer_transaction_mode": false,
        "recurring_jobs": {
          "anthropic_compat_refresh": {
            "enabled": true,
            "interval_secs": 86400,
            "jitter_secs": 30
          },
          "apalis_housekeeping": {
            "enabled": true,
            "interval_secs": 3600,
            "jitter_secs": 30
          },
          "oauth_refresh_watchdog": {
            "enabled": true,
            "interval_secs": 9360,
            "jitter_secs": 30
          },
          "oauth_usage_poll": {
            "enabled": true,
            "interval_secs": 60,
            "jitter_secs": 0
          },
          "pool_quota_snapshot": {
            "enabled": true,
            "interval_secs": 60,
            "jitter_secs": 0
          },
          "price_catalog_refresh": {
            "enabled": true,
            "interval_secs": 3600,
            "jitter_secs": 30
          },
          "prompt_cache_purge": {
            "enabled": true,
            "interval_secs": 600,
            "jitter_secs": 30
          },
          "quota_gc": {
            "enabled": true,
            "interval_secs": 3600,
            "jitter_secs": 30
          },
          "usage_prune": {
            "enabled": true,
            "interval_secs": 86400,
            "jitter_secs": 30
          },
          "usage_rollup": {
            "enabled": true,
            "interval_secs": 30,
            "jitter_secs": 3
          },
          "warmup_watchdog": {
            "enabled": true,
            "interval_secs": 6000,
            "jitter_secs": 30
          }
        },
        "retry_classes": {
          "adaptive": {
            "base_secs": 30,
            "max_attempts": 5,
            "max_secs": 600
          },
          "maintenance": {
            "base_secs": 60,
            "max_attempts": 1,
            "max_secs": 60
          },
          "probe": {
            "base_secs": 1,
            "max_attempts": 3,
            "max_secs": 5
          }
        },
        "separate_pool": {
          "acquire_timeout_secs": 5,
          "idle_timeout_secs": 600,
          "max_connections": 5,
          "min_connections": 1,
          "sslmode": "prefer",
          "statement_timeout_secs": 30
        },
        "singleton_concurrency": 2,
        "staleness": {
          "warmup_effect_retention_days": 30
        }
      }
    },
    "storage": {
      "$ref": "#/$defs/StorageConfig",
      "default": {
        "kind": "sqlite",
        "path": "/var/lib/cc-lb/storage.sqlite"
      }
    },
    "subscription_quota": {
      "$ref": "#/$defs/SubscriptionQuotaConfig",
      "default": {
        "dedup_elapsed_override_secs": 30,
        "enabled": true,
        "gc_batch_size": 10000,
        "retention_days": 30,
        "routing_max_staleness_secs": 1800,
        "writer_batch_max_records": 256,
        "writer_channel_capacity": 4096,
        "writer_flush_ms": 100
      }
    },
    "timeouts": {
      "$ref": "#/$defs/TimeoutsConfig",
      "default": {
        "drain_secs": 60,
        "idle_secs": 300,
        "request_body_chunk_secs": 30,
        "request_header_secs": 10,
        "upstream_total_secs": 600
      }
    },
    "tls": {
      "anyOf": [
        {
          "$ref": "#/$defs/TlsConfig"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "AdminConfig": {
      "type": "object",
      "properties": {
        "token_env": {
          "type": "string",
          "default": "CC_LB_ADMIN_TOKEN"
        }
      }
    },
    "AeadConfig": {
      "type": "object",
      "properties": {
        "key_env": {
          "type": "string",
          "default": "CC_LB_MASTER_KEY"
        }
      }
    },
    "AnthropicOAuthConfig": {
      "type": "object",
      "properties": {
        "auth_url": {
          "type": "string",
          "format": "uri",
          "default": "https://claude.ai/oauth/authorize"
        },
        "client_id": {
          "type": "string",
          "default": "9d1c250a-e61b-44d9-88ed-5944d1962f5e"
        },
        "redirect_uri": {
          "type": "string",
          "format": "uri",
          "default": "https://console.anthropic.com/oauth/code/callback"
        },
        "scopes": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "token_url": {
          "type": "string",
          "format": "uri",
          "default": "https://console.anthropic.com/v1/oauth/token"
        }
      }
    },
    "ApiKeysConfig": {
      "type": "object",
      "properties": {
        "price_catalog": {
          "$ref": "#/$defs/PriceCatalogConfig",
          "default": {
            "cache_path": "/var/lib/cc-lb/litellm.json",
            "refresh_interval": "1h",
            "url": "https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json"
          }
        },
        "usage_retention_days": {
          "type": "integer",
          "format": "uint64",
          "default": 90,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "BodyConfig": {
      "type": "object",
      "properties": {
        "files_cap_bytes": {
          "type": "integer",
          "format": "uint64",
          "default": 104857600,
          "minimum": 0
        },
        "messages_cap_bytes": {
          "type": "integer",
          "format": "uint64",
          "default": 33554432,
          "minimum": 0
        },
        "per_route_overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "default": {}
        }
      }
    },
    "BulkheadConfig": {
      "type": "object",
      "properties": {
        "max_conns_per_upstream": {
          "type": "integer",
          "format": "uint32",
          "default": 50,
          "minimum": 0
        },
        "semaphore_per_upstream": {
          "type": "integer",
          "format": "uint32",
          "default": 100,
          "minimum": 0
        }
      }
    },
    "CircuitBreakerConfig": {
      "type": "object",
      "properties": {
        "failures_to_open": {
          "type": "integer",
          "format": "uint32",
          "default": 5,
          "minimum": 0
        },
        "half_open_after_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 30,
          "minimum": 0
        },
        "window_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 10,
          "minimum": 0
        }
      }
    },
    "DnsConfig": {
      "type": "object",
      "properties": {
        "cache_ttl_ceiling_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 300,
          "minimum": 0
        },
        "cache_ttl_floor_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 30,
          "minimum": 0
        }
      }
    },
    "DownstreamAuthConfig": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/DownstreamAuthMode",
          "default": "api_key"
        },
        "none_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/NoneModeConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "DownstreamAuthMode": {
      "type": "string",
      "enum": [
        "none",
        "api_key"
      ]
    },
    "Duration": {
      "type": "object",
      "properties": {
        "nanos": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "secs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "secs",
        "nanos"
      ]
    },
    "EgressConfig": {
      "type": "object",
      "properties": {
        "allowed_hosts": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "LifecycleApiKeyMetricsSubscriberConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "LifecycleCacheHitMissSubscriberConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "LifecycleCacheObservationSubscriberConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "LifecycleHookAdapterConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "LifecycleLimitReconcileSubscriberConfig": {
      "description": "RFC-0002 Phase 8 subscriber for post-response limit reservation reconciliation.\n\nDefault: `enabled=true, shadow=false` — subscriber is authoritative; the\nhandler no longer reconciles inline. Set `shadow=true` to compare against a\nlegacy path (kept for debugging only). Set `enabled=false` to opt out\nentirely; reservations then reconcile only via TTL refund.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "shadow": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "LifecycleLimitRejectionAuditSubscriberConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "LifecyclePricingSubscriberConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "LifecyclePromptCacheDriftSubscriberConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "LifecycleRateLimitHeaderSubscriberConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "LifecycleShadowWriterConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "LifecycleSubscriptionQuotaSubscriberConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "LimitReservationTtlConfig": {
      "description": "RFC-0002 Phase 7 background TTL sweeper for stale limit reservations.\n\nWhen enabled, the LimitEngine periodically walks its reservation map and\nfull-refunds any reservation older than `ttl_secs`. This is opt-in in\nPhase 7 and enabled unconditionally in Phase 8 once the subscriber path\nis authoritative.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "tick_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 30,
          "minimum": 0
        },
        "ttl_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 300,
          "minimum": 0
        }
      }
    },
    "ListenerConfig": {
      "type": "object",
      "properties": {
        "admin_addr": {
          "type": "string",
          "default": "[::1]:9090"
        },
        "metrics_addr": {
          "type": "string",
          "default": "[::1]:9091"
        },
        "proxy_addr": {
          "type": "string",
          "default": "[::]:8080"
        },
        "tls": {
          "anyOf": [
            {
              "$ref": "#/$defs/TlsConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "unix_socket": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "NoneModeConfig": {
      "type": "object",
      "properties": {
        "principal_id": {
          "type": "string",
          "default": ""
        },
        "upstream_kind": {
          "$ref": "#/$defs/NoneModeUpstreamKind",
          "default": "anthropic_key"
        }
      },
      "additionalProperties": false
    },
    "NoneModeUpstreamKind": {
      "type": "string",
      "enum": [
        "anthropic_key",
        "anthropic_o_auth"
      ]
    },
    "OAuthConfig": {
      "type": "object",
      "properties": {
        "anthropic": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnthropicOAuthConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ObservabilityConfig": {
      "type": "object",
      "properties": {
        "log_redaction": {
          "type": "boolean",
          "default": true
        },
        "otlp_endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "prometheus_endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "tracing_level": {
          "type": "string",
          "default": "info"
        },
        "user_prompt_redaction": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "PluginFailurePolicy": {
      "description": "What to do when a filter or shape plugin fails at the runtime\nboundary (trap, fuel exhaustion, pool saturation, invalid wire\noutput). `PassThrough` is the historical behaviour: filter treats\nthe failure as no-op and shape falls back to raw upstream\npassthrough. `FailClosed` returns 503 upstream unavailable — pick\nthis when the plugin enforces load-bearing authz / tenant policy\nand cannot silently degrade.",
      "type": "string",
      "enum": [
        "pass_through",
        "fail_closed"
      ]
    },
    "PluginWireBounds": {
      "description": "Upper bounds enforced on plugin wire I/O. Defaults match current\nunbounded-ish behaviour by tracking the request body cap already\nenforced at the HTTP layer, so enabling this struct with defaults\nis a no-op. Tightening any field is opt-in.",
      "type": "object",
      "properties": {
        "max_header_value_bytes": {
          "type": "integer",
          "format": "uint32",
          "default": 8192,
          "minimum": 0
        },
        "max_headers": {
          "type": "integer",
          "format": "uint32",
          "default": 100,
          "minimum": 0
        },
        "normalize_error_body_bytes": {
          "type": "integer",
          "format": "uint64",
          "default": 262144,
          "minimum": 0
        },
        "output_body_bytes": {
          "type": "integer",
          "format": "uint64",
          "default": 104857600,
          "minimum": 0
        },
        "reason_bytes": {
          "type": "integer",
          "format": "uint32",
          "default": 256,
          "minimum": 0
        }
      }
    },
    "PostgresPoolConfig": {
      "type": "object",
      "properties": {
        "acquire_timeout_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 5,
          "minimum": 0
        },
        "idle_timeout_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 600,
          "minimum": 0
        },
        "max_connections": {
          "type": "integer",
          "format": "uint32",
          "default": 10,
          "minimum": 0
        },
        "min_connections": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "sslmode": {
          "type": "string",
          "default": "prefer"
        },
        "statement_timeout_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 30,
          "minimum": 0
        }
      }
    },
    "PriceCatalogConfig": {
      "type": "object",
      "properties": {
        "cache_path": {
          "type": "string",
          "default": "/var/lib/cc-lb/litellm.json"
        },
        "refresh_interval": {
          "$ref": "#/$defs/Duration",
          "default": "1h"
        },
        "url": {
          "type": "string",
          "default": "https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json"
        }
      },
      "additionalProperties": false
    },
    "PromptCacheShadowConfig": {
      "description": "Prompt cache shadow mode configuration.\n\nControls the prompt cache observation cache behavior. When `enabled=false`, the cache layer\nis not constructed and observation flow is gated off at the lifecycle level for byte-equivalent\npre-T22 behavior (no observation enqueue, no snapshot, no sweeper). When `enabled=true`,\nthe full cache pipeline activates: observations from successful responses are decoded,\nupserted into the in-memory cache, and enqueued for persistent storage; `build_candidates`\nsnapshots cache state per upstream to compute cache scores.\n\nConfiguration keys and defaults:\n- `enabled` (default: false) - gate all observation flow and sweeper spawn\n- `grace_margin_secs` (default: 30) - minimum age before a cache hit is refreshed\n- `refresh_debounce_secs` (default: 60) - debounce window for refresh-on-hit persistence\n- `warm_set_cap` (default: 32) - max snapshot entries per upstream/model",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "grace_margin_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 30,
          "minimum": 0
        },
        "refresh_debounce_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 60,
          "minimum": 0
        },
        "warm_set_cap": {
          "type": "integer",
