---
source: crates/cc-lb-admin/tests/snapshot_admin_shapes.rs
expression: "serde_json::to_string_pretty(&json).unwrap()"
---
{
  "admin": {
    "token_env": "[REDACTED]"
  },
  "aead": {
    "key_env": "SECRET_STORAGE_KEY"
  },
  "api_keys": {
    "price_catalog": {
      "cache_path": "/var/lib/cc-lb/litellm.json",
      "refresh_interval": "1h",
      "url": "https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json"
    },
    "usage_retention_days": 90
  },
  "body": {
    "files_cap_bytes": 104857600,
    "messages_cap_bytes": 33554432,
    "per_route_overrides": {}
  },
  "bulkhead": {
    "max_conns_per_upstream": 50,
    "semaphore_per_upstream": 100
  },
  "circuit_breaker": {
    "failures_to_open": 5,
    "half_open_after_secs": 30,
    "window_secs": 10
  },
  "dns": {
    "cache_ttl_ceiling_secs": 300,
    "cache_ttl_floor_secs": 30
  },
  "downstream_auth": {
    "mode": "api_key"
  },
  "egress": {},
  "listener": {
    "admin_addr": "[::1]:9090",
    "metrics_addr": "[::1]:9091",
    "proxy_addr": "[::]:8080"
  },
  "oauth": {},
  "observability": {
    "log_redaction": true,
    "tracing_level": "info",
    "user_prompt_redaction": false
  },
  "plugins": {
    "observability_hooks": []
  },
  "principals": {
    "alice": {
      "allowed_models": [
        "claude-3-5-sonnet"
      ],
      "credentials_ref": "anthropic-key",
      "default_limits": [
        {
          "cap_micros": 123,
          "kind": "requests",
          "window": "1h"
        },
        {
          "cap_micros": 456,
          "kind": "input_tokens",
          "window": "1h"
        },
        {
          "cap_micros": 789,
          "kind": "output_tokens",
          "window": "1h"
        }
      ],
      "enabled": true,
      "principal_type": "machine"
    }
  },
  "signers": {
    "anthropic_oauth": {
      "client_id": "",
      "issuer_base_url": "https://platform.claude.com",
      "redirect_uri": "http://127.0.0.1/admin/oauth/callback",
      "scopes": [
        "messages",
        "files"
      ]
    }
  },
  "storage": {
    "kind": "redb",
    "oauth_aead_key_env": "[REDACTED]",
    "path": "/var/lib/cc-lb/storage.redb"
  },
  "timeouts": {
    "drain_secs": 60,
    "idle_secs": 300,
    "request_body_chunk_secs": 30,
    "request_header_secs": 10,
    "upstream_total_secs": 600
  },
  "upstreams": {
    "anthropic": {
      "auth_strategy": "api_key",
      "base_url": "https://api.anthropic.com/",
      "credentials_ref": "anthropic-key",
      "kind": "anthropic_direct"
    }
  }
}
