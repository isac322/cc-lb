---
import { Image } from 'astro:assets';
import accessStill from '../../../assets/media/access.png';
import logsStill from '../../../assets/media/logs.png';
import principalDetailStill from '../../../assets/media/principal-detail.png';
import upstreamsStill from '../../../assets/media/upstreams.png';
import usageStill from '../../../assets/media/usage.png';

const siteUrl = 'https://cc-lb.bhyoo.com';
const title = 'cc-lb | Anthropic-compatible load balancer for Claude Code';
const description =
  'Self-hosted Anthropic-compatible reverse proxy and load balancer for pooled API-key and OAuth upstreams.';
const stills = [
  {
    file: 'usage.png',
    image: usageStill,
    label: 'Overview',
    alt: 'cc-lb Overview screen with pool quota usage, traffic, cost, and top principals.',
  },
  {
    file: 'upstreams.png',
    image: upstreamsStill,
    label: 'Upstreams',
    alt: 'cc-lb Upstreams screen showing the paid-api-fallback API-key upstream with usage and recent successful requests.',
  },
  {
    file: 'access.png',
    image: accessStill,
    label: 'Principals',
    alt: 'cc-lb Principals screen with the ci-runner machine principal, its cache keepalive setting, recent requests, and router options.',
  },
  {
    file: 'principal-detail.png',
    image: principalDetailStill,
    label: 'Principal detail',
    alt: 'cc-lb principal detail for the mina-torres human principal with recent requests and router settings.',
  },
  {
    file: 'logs.png',
    image: logsStill,
    label: 'Logs',
    alt: 'cc-lb request log with recent rows routed to paid-api-fallback and their status, latency, tokens, and cost.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#161719" />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" href="/brand/favicon/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/brand/favicon/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/brand/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="cc-lb" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={`${siteUrl}/brand/social/cc-lb-social-preview.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/brand/social/cc-lb-social-preview.png`} />
    <title>{title}</title>
    <script is:inline>
      try {
        if (localStorage.getItem('cc-lb:star-note') === 'hidden') {
          document.documentElement.dataset.starNote = 'hidden';
        }
      } catch {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'cc-lb',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Linux',
      description,
      url: siteUrl,
      codeRepository: 'https://github.com/isac322/cc-lb',
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
    })} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="cc-lb home">
        <img class="brand-light" src="/brand/lockup/cc-lb-lockup-horizontal-on-light.svg" alt="cc-lb" />
        <img class="brand-dark" src="/brand/lockup/cc-lb-lockup-horizontal-on-dark.svg" alt="cc-lb" />
      </a>
      <nav aria-label="Primary navigation">
        <a href="/docs/">Docs</a>
        <a href="/docs/getting-started/">Install</a>
        <a class="nav-star" href="https://github.com/isac322/cc-lb" target="_blank" rel="noopener noreferrer" aria-label="Star cc-lb on GitHub (opens in a new tab)">
          <svg class="star-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z" />
          </svg>
          <span>Star<span class="nav-star-long"> on GitHub</span></span>
        </a>
      </nav>
    </header>

    <main>
      <section class="hero shell" aria-labelledby="hero-title">
        <div class="hero-copy">
          <h1 id="hero-title">One endpoint for pooled Anthropic traffic.</h1>
          <p class="hero-lede">
            cc-lb is a self-hosted reverse proxy and load balancer for API-key and OAuth upstreams.
            You control accounts, quota pressure, cache continuity, and runtime changes; your clients
            keep the standard Messages API contract.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="/docs/getting-started/">Run cc-lb</a>
            <a class="button button-secondary" href="/docs/concepts/">Read the model</a>
          </div>
          <p class="hero-boundary">
            Independent project. Anthropic and Claude Code are trademarks of Anthropic; cc-lb is not
            affiliated with or endorsed by Anthropic.
          </p>
        </div>

        <div class="request-panel" aria-label="Anthropic Messages API request path">
          <div class="panel-topline">
            <span>Request contract</span>
            <span>POST /v1/messages</span>
          </div>
          <pre><code><span class="code-muted">x-api-key:</span> $CC_LB_PROXY_KEY
<span class="code-muted">anthropic-version:</span> 2023-06-01
<span class="code-muted">content-type:</span> application/json

<span class="code-accent">authenticate principal</span>
<span class="code-muted">→</span> select an enabled upstream
<span class="code-muted">→</span> route the request
<span class="code-muted">→</span> stream the response</code></pre>
          <div class="panel-caption">
            Clients send an Anthropic Messages API request. You own what happens behind the endpoint.
          </div>
        </div>
      </section>

      <section id="star-note" class="star-note shell" aria-labelledby="star-note-title">
        <svg class="star-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path pathLength="1" d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z" />
        </svg>
        <div class="star-note-copy">
          <h2 id="star-note-title">Star cc-lb on GitHub</h2>
          <p>
            If cc-lb fits how you run Claude Code traffic, star the repository. Stars help other
            operators find cc-lb. The button opens GitHub, where you star it with your own account.
          </p>
        </div>
        <div class="star-note-actions">
          <a class="button button-star" href="https://github.com/isac322/cc-lb" target="_blank" rel="noopener noreferrer">
            <svg class="star-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z" />
            </svg>
            Star on GitHub<span class="sr-only"> (opens in a new tab)</span>
          </a>
          <span class="star-note-repo">github.com/isac322/cc-lb</span>
        </div>
        <button class="star-note-hide" type="button" data-star-note-hide hidden aria-label="Hide the GitHub star note">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
          <span>Hide</span>
        </button>
      </section>

      <section class="console-shell shell" aria-labelledby="console-title">
        <div class="section-heading">
          <p class="section-label">Admin console</p>
          <h2 id="console-title">Watch the pool from the admin console.</h2>
          <p id="console-description">
            A real-time walkthrough with no cuts: pool quota usage on Overview, recent requests per
            upstream and per principal, then three new requests arriving in Logs.
          </p>
        </div>
        <figure class="console-video">
          <video
            controls
            muted
            playsinline
            preload="none"
            width="1600"
            height="800"
            poster="/video/cc-lb-walkthrough-poster-1280.webp"
            aria-describedby="console-description console-caption"
          >
            <source media="(max-width: 700px)" src="/video/cc-lb-walkthrough-1280.webm" type="video/webm" />
            <source media="(max-width: 700px)" src="/video/cc-lb-walkthrough-1280.mp4" type="video/mp4" />
            <source src="/video/cc-lb-walkthrough-1600.webm" type="video/webm" />
            <source src="/video/cc-lb-walkthrough-1600.mp4" type="video/mp4" />
            <a class="text-link" href="/video/cc-lb-walkthrough-1600.mp4">Download the walkthrough (MP4)</a>
          </video>
          <figcaption id="console-caption">
            Real cc-lb 1.0.1 UI · synthetic fixture data · requests went through the proxy to a local
            mock upstream, so no provider received traffic · silent, 18.6 s
          </figcaption>
        </figure>
        <ul class="console-stills" aria-label="Admin console screenshots">
          {stills.map((still) => (
            <li>
              <a class="still-link" href={`/media/${still.file}`}>
                <Image
                  src={still.image}
                  alt={still.alt}
                  widths={[320, 480, 720]}
                  sizes="(max-width: 800px) 46vw, 220px"
                  format="webp"
                  loading="lazy"
                  decoding="async"
                />
                <span>{still.label}<span class="sr-only"> (full-size PNG)</span></span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="operator-shell shell" aria-labelledby="operator-title">
        <div class="section-heading">
          <p class="section-label">Operator control</p>
          <h2 id="operator-title">You run the pool. Clients keep their request shape.</h2>
        </div>
        <div class="operator-body">
          <p>
            Pool compatible accounts behind a managed endpoint. Configure upstreams, principals, proxy
            keys, storage, and plugin chains from database-backed runtime state.
          </p>
          <p>
            Each client keeps its existing Messages API calls and points them at <code>/v1/messages</code>
            with a proxy key you issue. Routing stays behind that request boundary.
          </p>
          <div class="operator-links">
            <a class="text-link" href="/docs/operations/">Open the operator guide</a>
            <a class="text-link" href="/docs/getting-started/install/">Issue a key and send the first request</a>
          </div>
        </div>
      </section>

      <section class="install-shell shell" aria-labelledby="install-title">
        <div class="section-heading install-heading">
          <div>
            <p class="section-label">Start locally</p>
            <h2 id="install-title" tabindex="-1">Choose the runtime that fits your host.</h2>
          </div>
          <p>
            The source build and the published image use the same server contract. Use the path that
            matches your deployment boundary.
          </p>
        </div>
        <div class="install-grid">
          <article class="install-option">
            <div class="option-header">
              <h3>Build the binary</h3>
              <span class="option-meta">Rust + Bun</span>
            </div>
            <p>Build the server from the repository with the pinned toolchain and bundled admin app.</p>
            <pre><code>rustup target add wasm32-unknown-unknown
cargo build --release -p cc-lb-server
./target/release/cc-lb serve \
  --config cc-lb.toml \
  --data-dir ./data/runtime</code></pre>
            <a class="text-link" href="/docs/getting-started/">Read binary prerequisites</a>
          </article>
          <article class="install-option">
            <div class="option-header">
              <h3>Run the image</h3>
              <span class="option-meta">GHCR · 1.0.1</span>
            </div>
            <p>Run the published multi-architecture image and mount your config and durable data.</p>
            <pre><code>docker run --rm --name cc-lb \
  --user "$(id -u):$(id -g)" \
  --env-file .env \
  -p 8080:8080 -p 9090:9090 \
  -v "$PWD/cc-lb.container.toml:/etc/cc-lb/cc-lb.toml:ro" \
  -v "$PWD/data:/var/lib/cc-lb" \
  ghcr.io/isac322/cc-lb:1.0.1</code></pre>
            <a class="text-link" href="/docs/getting-started/#run-the-published-container">Read container setup</a>
          </article>
        </div>
      </section>

      <section class="proof-shell shell" aria-labelledby="proof-title">
        <div class="section-heading">
          <p class="section-label">Mechanism proof</p>
          <h2 id="proof-title">The routing model is explicit.</h2>
          <p>
            These are the shipped contracts behind the landing page. Each one links to the source-backed
            explanation rather than a benchmark or a promise.
          </p>
        </div>
        <div class="proof-grid">
          <article class="proof-item">
            <h3>Pool API-key and OAuth upstreams</h3>
            <p>Route Messages API traffic through the two supported upstream kinds.</p>
            <a class="text-link" href="/docs/concepts/upstreams/">Read upstreams</a>
          </article>
          <article class="proof-item">
            <h3>Preserve active session cache continuity</h3>
            <p>Use best-effort keepalive scheduling before configured cache TTLs expire.</p>
            <a class="text-link" href="/docs/concepts/prompt-cache/">Read cache continuity</a>
          </article>
          <article class="proof-item">
            <h3>Pace quota across rolling windows</h3>
            <p>Apply cost-first, deterministic candidate selection under weekly pacing rules.</p>
            <a class="text-link" href="/docs/concepts/quota-routing/">Read quota routing</a>
          </article>
          <article class="proof-item">
            <h3>Extend with Wasmtime hooks</h3>
            <p>Add filter and request, response, or SSE shaping behavior without editing the core proxy.</p>
            <a class="text-link" href="/docs/plugins/">Read the plugin contract</a>
          </article>
          <article class="proof-item">
            <h3>Manage runtime state from the database</h3>
            <p>Update upstreams, principals, keys, and plugin chains without rebuilding the binary.</p>
            <a class="text-link" href="/docs/operations/runtime-management/">Read runtime management</a>
          </article>
        </div>
      </section>

      <section class="flow-shell shell" aria-labelledby="flow-title">
        <div class="section-heading">
          <p class="section-label">Operator flow</p>
          <h2 id="flow-title">From secret setup to the first request.</h2>
        </div>
        <ol class="flow-list">
          <li>
            <strong>Set the boundary.</strong>
            <p>Provide the master key, admin token, and upstream credential through your deployment environment.</p>
          </li>
          <li>
            <strong>Create runtime state.</strong>
            <p>Use the authenticated admin API to create an upstream, principal, and proxy key.</p>
          </li>
          <li>
            <strong>Send standard traffic.</strong>
            <p>Point an Anthropic-compatible client at the proxy and inspect the response or stream diagnostics.</p>
          </li>
        </ol>
        <a class="text-link" href="/docs/getting-started/install/">Follow the complete setup</a>
      </section>

      <section class="scope-shell shell" aria-labelledby="scope-title">
        <div class="scope-copy">
          <p class="section-label">Scope and trust</p>
          <h2 id="scope-title">Open source with explicit limits.</h2>
          <p>
            cc-lb is built for self-hosting teams operating Anthropic-compatible traffic. The current
            public upstream contract is intentionally bounded; read the trust notes before deploying.
          </p>
        </div>
        <div class="scope-list">
          <div>
            <span>Supported</span>
            <strong>Anthropic API-key and OAuth upstreams</strong>
          </div>
          <div>
            <span>Runtime</span>
            <strong>SQLite for local single-node use; PostgreSQL for shared durable state</strong>
          </div>
          <div>
            <span>Extension</span>
            <strong>Wasmtime filter and request, response, or SSE shaping hooks</strong>
          </div>
        </div>
        <a class="text-link" href="/docs/trust/">Read trust and scope notes</a>
      </section>

      <section class="support-shell shell" aria-labelledby="support-title">
        <div class="support-copy">
          <p class="section-label">Support the project</p>
          <h2 id="support-title">Running cc-lb? Star it and report what breaks.</h2>
          <p>
            Stars help other operators find cc-lb. Issues with a reproduction help fix what you hit in
            your own deployment.
          </p>
        </div>
        <div class="support-actions">
          <a class="button button-secondary" href="https://github.com/isac322/cc-lb" target="_blank" rel="noopener noreferrer">
            <svg class="star-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z" />
            </svg>
            Star on GitHub<span class="sr-only"> (opens in a new tab)</span>
          </a>
          <a class="text-link" href="https://github.com/isac322/cc-lb/issues" target="_blank" rel="noopener noreferrer">Open an issue<span class="sr-only"> (opens in a new tab)</span></a>
        </div>
      </section>
    </main>

    <footer class="site-footer shell">
      <span>cc-lb · Apache-2.0 · <a class="footer-link" href="https://github.com/isac322/cc-lb" target="_blank" rel="noopener noreferrer">Source on GitHub<span class="sr-only"> (opens in a new tab)</span></a></span>
      <span>Anthropic-compatible load balancer for Claude Code</span>
      <span>Independent project, not affiliated with Anthropic.</span>
    </footer>

    <script is:inline>
      (() => {
        const hide = document.querySelector('[data-star-note-hide]');
        if (!hide) return;
        hide.hidden = false;
        hide.addEventListener('click', () => {
          document.documentElement.dataset.starNote = 'hidden';
          try {
            localStorage.setItem('cc-lb:star-note', 'hidden');
          } catch {}
          document.getElementById('install-title')?.focus({ preventScroll: true });
        });
      })();
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: #161719;
    color: #e9eaeb;
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    min-width: 320px;
    background: #161719;
    color: #e9eaeb;
    font-family: "Avenir Next", "Helvetica Neue", Helvetica, Arial, sans-serif;
    line-height: 1.55;
  }

  :global(a) {
    color: inherit;
  }

  :global(code),
  :global(pre) {
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
  }

  .shell {
    width: min(1160px, calc(100% - 48px));
    margin: 0 auto;
  }

  .site-header {
    width: min(1160px, calc(100% - 48px));
    min-height: 76px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid #2f3033;
  }

  .brand {
    display: block;
    width: 128px;
  }

  .brand img {
    display: block;
    width: 100%;
    height: auto;
  }

  .brand-light {
    display: none !important;
  }

  .brand-dark {
    display: block !important;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 24px;
    color: #b4b6b9;
    font-size: 0.84rem;
  }

  nav a,
  .text-link {
    text-decoration: underline;
    text-decoration-color: #5f6267;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  nav a:hover,
  .text-link:hover {
    color: #ffffff;
    text-decoration-color: #ccddee;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .nav-star {
    display: inline-flex;
    min-height: 36px;
    align-items: center;
    gap: 8px;
    padding: 0 12px;
    border: 1px solid #ccddee;
    color: #f4f5f5;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 160ms ease-out, color 160ms ease-out;
  }

  .nav-star .star-icon {
    color: #ccddee;
  }

  .nav-star:hover {
    background: #ccddee;
    color: #161719;
  }

  .nav-star:hover .star-icon {
    color: #161719;
  }

  .star-icon {
    width: 16px;
    height: 16px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linejoin: round;
  }

  .button .star-icon {
    margin-right: 8px;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(360px, 0.9fr);
    align-items: center;
    gap: clamp(48px, 8vw, 112px);
    padding-top: 112px;
    padding-bottom: 72px;
  }

  .hero-copy {
    animation: arrive 560ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1,
  h2,
  h3 {
    color: #f4f5f5;
    letter-spacing: -0.035em;
  }

  h1 {
    max-width: 720px;
    margin-bottom: 28px;
    font-size: clamp(3.1rem, 7vw, 6.4rem);
    line-height: 0.94;
    font-weight: 760;
  }

  h2 {
    margin-bottom: 18px;
    font-size: clamp(2rem, 4vw, 3.7rem);
    line-height: 1;
    font-weight: 720;
  }

  h3 {
    margin-bottom: 12px;
    font-size: 1.06rem;
    line-height: 1.2;
    font-weight: 680;
  }

  .hero-lede {
    max-width: 680px;
    margin-bottom: 32px;
    color: #c1c3c6;
    font-size: clamp(1.05rem, 1.5vw, 1.28rem);
    line-height: 1.52;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 28px;
  }

  .button {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    border: 1px solid #6e747c;
    font-weight: 700;
    text-decoration: none;
  }

  .button:focus-visible,
  nav a:focus-visible,
  .text-link:focus-visible,
  .brand:focus-visible {
    outline: 2px solid #ccddee;
    outline-offset: 4px;
  }

  .button-primary {
    border-color: #ccddee;
    background: #ccddee;
    color: #161719;
  }

  .button-primary:hover {
    border-color: #f4f5f5;
    background: #f4f5f5;
  }

  .button-secondary {
    color: #e9eaeb;
  }

  .button-secondary:hover {
    border-color: #e9eaeb;
    background: #232528;
  }

  .hero-boundary {
    max-width: 620px;
    margin-bottom: 0;
    color: #888b90;
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .request-panel {
    border: 1px solid #45484d;
    background: #1e2023;
    animation: arrive 560ms 90ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .panel-topline,
  .option-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .panel-topline {
    padding: 16px 18px;
